# Aurora — environment template.
# Copy to `.env` and fill in your values. `.env` is gitignored.

# ---- LLM provider (one of: anthropic / openai / gemini / ollama / openai_compatible / none) ----
AURORA_LLM_PROVIDER=none

# ---- Anthropic Claude (set if AURORA_LLM_PROVIDER=anthropic) ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- OpenAI (set if AURORA_LLM_PROVIDER=openai) ----
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ---- Google Gemini (set if AURORA_LLM_PROVIDER=gemini) ----
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# ---- Ollama (set if AURORA_LLM_PROVIDER=ollama) ----
# When running Aurora in Docker on a host that has Ollama installed,
# host.docker.internal lets the container reach the host's Ollama.
# On Linux without Docker Desktop, set this to your host IP explicitly.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=gemma3:12b

# ---- OpenAI-compatible (Groq, OpenRouter, vLLM, LM Studio, etc.) ----
# OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai
# OPENAI_COMPATIBLE_API_KEY=...
# OPENAI_COMPATIBLE_MODEL=mixtral-8x7b-32768

# ---- Aurora behavior ----
# Skip auto-seed-ingest of the knowledge bank on first start.
# AURORA_NO_KB_BOOTSTRAP=0
# Skip auto-download of domain knowledge packs.
# AURORA_NO_PACK_AUTODOWNLOAD=0
