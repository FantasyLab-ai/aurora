# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log

# ---- Frontend build (v0.10 Phase 2 — Vite + TypeScript) ----
# node_modules ships nothing useful to the repo; same for the
# generated bundle output. The TS source under frontend/src/ IS
# tracked — only the build artifacts are ignored.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.log
frontend/npm-debug.log*
# ESLint cache + Vite cache.
frontend/.eslintcache
.vite/

# ---- Virtualenv ----
.venv/
venv/
.venv_*/
venv_*/
**/.venv/
**/venv/

# ---- Data / external ----
fantasyai/data/external/
data/
datasets/
*.csv
*.parquet
*.zip
*.gz
*.txt

# But: demos/datasets/ ships source files (generators, extractors, READMEs)
# alongside generated CSVs. Track the source; let the *.csv rule keep the
# generated data out of git.
!demos/datasets/
!demos/datasets/**/
!demos/datasets/**/*.py
!demos/datasets/**/*.md

# The 3 demo fixtures the bundled desktop app ships for "try a demo".
# The PyInstaller spec bundles data/fixtures/ as an app resource, so these
# MUST reach a clean CI checkout -- otherwise the release build fails with
# "Unable to find data\fixtures". Re-include them past the data/ + *.csv
# rules above.
!data/fixtures/
!data/fixtures/*.csv
*.exe
# Allow our actual dependency manifests through the *.txt rule above.
!requirements.txt
!requirements-dev.txt

# ---- Outputs ----
outputs/
plots/
plots_data/
runs/

# ---- Large artifacts ----
*.pkl
*.joblib
*.npy
*.npz
*.db
*.sqlite*

# ---- Dev backups (created locally during refactors; never publish) ----
_backups_*/
*.bak
*.bak_*
*.bak.*
**/*.py.bak_*
**/*.py.bak.*

# ---- Data uploads (the studio's per-session upload cache) ----
data/uploads/
data/external/

# ---- Test scratch + tmp ----
tmp/
.tmp/
*.tmp

# ---- Claude Code working state — keep local, never publish ----
.claude/
# Per-user MCP server config — paths are local; never publish.
# See docs/mcp.md for how to author one.
.mcp.json
.mcp.json.local

# ---- Aurora user-data (knowledge bank, learning store, contract output) ----
# Per-user state; not for sharing by default. Users opt in to share via
# the federated knowledge contribution flow (roadmap).
.aurora/
**/.aurora/

# ---- Decision-contract output (per-user audit logs) ----
contracts_output/

# ---- Aurora Cloud Phase 1 — bind-mounted persistence ----
# These two dirs live alongside docker-compose.yml and hold the
# container's persistent state. Never publish them.
aurora-data/
aurora-config/

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# ---- Test artifacts ----
.coverage
htmlcov/
.tox/

# ---- Build / dist ----
build/
dist/
*.egg-info/
*.egg

# ---- Secrets — never commit (defense in depth) ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
config/secrets.yml

# ---- Scratch / TODO files ----
.github/PINNED_ISSUES_TODO.md
SCRATCH.md
TODO_PRIVATE.md

# PyInstaller build logs (worktree root)
pyinstaller-build-*.log
desktop-build*.log
