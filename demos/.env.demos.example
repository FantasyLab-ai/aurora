# Aurora demos — environment template.
#
# Copy to `.env.demos` (gitignored) and paste your real webhook URLs.
# Then load it into the current PowerShell with:
#
#     . .\demos\load_env.ps1
#
# The relay reads these env vars at startup. Never commit `.env.demos`.

# ---- Demo 2 — Community Sentinel (Discord) -------------------------------
# Create a webhook: Discord channel → Edit → Integrations → Webhooks → New.
# Looks like: https://discord.com/api/webhooks/<id>/<token>
AURORA_DEMO_DISCORD_WEBHOOK=

# ---- Demo 3 — The Save (Slack) ------------------------------------------
# Create a webhook: api.slack.com/apps → Incoming Webhooks → Add to Workspace.
# Looks like: https://hooks.slack.com/services/T.../B.../...
AURORA_DEMO_SLACK_WEBHOOK=

# ---- Demo 1 — Aurora Alarm (physical device, optional) -------------------
# Either an ESP32 firmware HTTP endpoint or a Shelly smart-plug LAN IP.
# AURORA_DEMO_DEVICE_URL  = http://192.168.1.50
# AURORA_DEMO_DEVICE_KIND = shelly         # or "esp32"

# ---- Relay behaviour ----------------------------------------------------
# Subset of adapters to enable. "auto" (default) = everything configured above.
# Comma-separated overrides: AURORA_DEMO_ADAPTERS=discord,sse,log
# AURORA_DEMO_ADAPTERS = auto

# Where the fire-log lives (relative path is fine).
# AURORA_DEMO_LOG_PATH = demos/relay/fires.jsonl

# Relay port (default 7077).
# AURORA_DEMO_PORT = 7077

# ---- Aurora behaviour (auto-set by load_env.ps1) -------------------------
# Aurora's WebhookAction normally refuses loopback targets (SSRF guard).
# The demos POST from Aurora to the local relay at 127.0.0.1:7077, so this
# must be on. `load_env.ps1` sets it automatically — only uncomment to
# override (e.g. force-disable for a non-demo run from the same shell).
# AURORA_ALLOW_LOCAL_WEBHOOKS=1
