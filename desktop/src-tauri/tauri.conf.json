{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "mainBinaryName": "Aurora",
  "version": "0.2.0",
  "identifier": "ai.fantasylab.aurora",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aurora",
        "width": 1400,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/dist/aurora-backend": "aurora-backend"
    }
  }
}
