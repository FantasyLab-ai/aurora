import numpy as np

def run_default_digital_twin(
    schema_contract: dict,
    df_numeric,
    seed: int = 42,
    horizon: int = 24,
    n_sims: int = 2000,
):
    rng = np.random.default_rng(seed)

    if df_numeric is None or df_numeric.shape[1] == 0:
        return {
            "status": "skipped",
            "reason": "no_numeric_data",
            "schema_contract": schema_contract,
        }

    # 🎯 SCHEMA-DRIVEN TARGET SELECTION
    targets = schema_contract.get("recommended_targets", [])
    target = targets[0] if targets else df_numeric.columns[0]

    series = df_numeric[target].dropna().values
    if len(series) < 10:
        return {
            "status": "skipped",
            "reason": "insufficient_target_history",
            "target": target,
        }

    mu = float(np.mean(series))
    sigma = float(np.std(series) + 1e-9)

    sims = rng.normal(mu, sigma, size=(n_sims, horizon))
    p05 = np.percentile(sims, 5, axis=0).tolist()
    p50 = np.percentile(sims, 50, axis=0).tolist()
    p95 = np.percentile(sims, 95, axis=0).tolist()

    return {
        "status": "ok",
        "target": target,
        "chosen_model": "gaussian_baseline",
        "risk_surface": {
            "p05": p05,
            "p50": p50,
            "p95": p95,
            "terminal": {
                "min": float(np.min(sims)),
                "max": float(np.max(sims)),
            },
        },
        "schema_contract": schema_contract,
    }
