from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import pandas as pd


def _to_numeric_frame(df: pd.DataFrame, cols: List[str]) -> pd.DataFrame:
    X = df[cols].copy()
    for c in cols:
        X[c] = pd.to_numeric(X[c], errors="coerce")
    X = X.replace([np.inf, -np.inf], np.nan)
    return X


def _safe_standardize(X: pd.DataFrame) -> Tuple[np.ndarray, Dict[str, Any]]:
    # simple standardization, no sklearn dependency
    arr = X.to_numpy(dtype=float)
    mu = np.nanmean(arr, axis=0)
    sd = np.nanstd(arr, axis=0)
    sd = np.where((sd == 0) | ~np.isfinite(sd), 1.0, sd)
    Z = (arr - mu) / sd
    # impute remaining NaN to 0 after standardization (mean)
    Z = np.where(np.isfinite(Z), Z, 0.0)
    meta = {"mu": mu.tolist(), "sd": sd.tolist()}
    return Z, meta


def _sigmoid(z: np.ndarray) -> np.ndarray:
    z = np.clip(z, -35, 35)
    return 1.0 / (1.0 + np.exp(-z))


def _fit_logistic_ridge(Z: np.ndarray, t: np.ndarray, l2: float = 1.0, iters: int = 500) -> np.ndarray:
    # deterministic ridge logistic regression (Newton-ish via gradient steps)
    n, p = Z.shape
    w = np.zeros(p, dtype=float)
    lr = 0.1
    for _ in range(iters):
        p_hat = _sigmoid(Z @ w)
        grad = (Z.T @ (p_hat - t)) / n + l2 * w
        w -= lr * grad
    return w


def _fit_linear_ridge(Z: np.ndarray, y: np.ndarray, l2: float = 1.0) -> np.ndarray:
    # closed form ridge
    n, p = Z.shape
    A = (Z.T @ Z) / n + l2 * np.eye(p)
    b = (Z.T @ y) / n
    w = np.linalg.solve(A, b)
    return w


def _bootstrap_ci(values: np.ndarray, alpha: float = 0.05, B: int = 500, seed: int = 0) -> Dict[str, Any]:
    rng = np.random.default_rng(seed)
    n = len(values)
    if n < 50:
        return {"note": "too_few_points_for_bootstrap"}
    means = []
    for _ in range(B):
        idx = rng.integers(0, n, size=n)
        means.append(float(np.mean(values[idx])))
    lo = float(np.quantile(means, alpha / 2))
    hi = float(np.quantile(means, 1 - alpha / 2))
    return {"method": "bootstrap", "alpha": float(alpha), "B": int(B), "lo": lo, "hi": hi}


def estimate_ate_binary_dr(
    df: pd.DataFrame,
    treatment_col: str,
    outcome_col: str,
    covariate_cols: Optional[List[str]] = None,
    seed: int = 0,
) -> Dict[str, Any]:
    """
    Doubly-Robust AIPW ATE estimator.
    Requires treatment_col binary {0,1}. Outcome can be continuous.
    """

    if treatment_col not in df.columns or outcome_col not in df.columns:
        return {"error": "missing_required_columns"}

    t_raw = pd.to_numeric(df[treatment_col], errors="coerce")
    y_raw = pd.to_numeric(df[outcome_col], errors="coerce")

    # default covariates: numeric columns excluding T and Y
    if covariate_cols is None:
        num_cols = df.select_dtypes(include="number").columns.tolist()
        covariate_cols = [c for c in num_cols if c not in (treatment_col, outcome_col)]

    if not covariate_cols:
        return {"error": "no_covariates_available"}

    X = _to_numeric_frame(df, covariate_cols)
    m = t_raw.notna() & y_raw.notna()
    # require at least some X non-null per row
    m = m & X.notna().any(axis=1)

    t = t_raw[m].astype(float).values
    y = y_raw[m].astype(float).values
    X = X.loc[m].fillna(X.median(numeric_only=True))

    # enforce binary
    t = np.where(t >= 0.5, 1.0, 0.0)
    n = int(len(t))
    if n < 200:
        return {"error": "too_few_rows", "n": n}

    # standardize
    Z, zmeta = _safe_standardize(X)

    # Propensity model e(x) = P(T=1|X)
    w_e = _fit_logistic_ridge(Z, t, l2=1.0, iters=600)
    e = _sigmoid(Z @ w_e)
    # clip to avoid division explosions
    e = np.clip(e, 0.02, 0.98)

    # Outcome models mu0(x), mu1(x) via ridge regression
    w0 = _fit_linear_ridge(Z[t == 0], y[t == 0], l2=1.0) if np.any(t == 0) else np.zeros(Z.shape[1])
    w1 = _fit_linear_ridge(Z[t == 1], y[t == 1], l2=1.0) if np.any(t == 1) else np.zeros(Z.shape[1])
    mu0 = Z @ w0
    mu1 = Z @ w1

    # DR / AIPW score
    score = (mu1 - mu0) + (t * (y - mu1) / e) - ((1 - t) * (y - mu0) / (1 - e))
    ate = float(np.mean(score))

    # uncertainty: bootstrap CI on the DR scores (fast + robust)
    ci = _bootstrap_ci(score, alpha=0.05, B=600, seed=seed)

    # sanity diagnostics
    treat_rate = float(np.mean(t))
    overlap = float(np.mean((e > 0.05) & (e < 0.95)))

    return {
        "method": "ATE_DR_AIPW",
        "n": n,
        "treatment_col": treatment_col,
        "outcome_col": outcome_col,
        "covariates_n": int(len(covariate_cols)),
        "covariates_used": covariate_cols[:80],
        "ate": ate,
        "ci95": ci,
        "diagnostics": {
            "treatment_rate": treat_rate,
            "overlap_rate_e_between_0p05_0p95": overlap,
            "propensity": {"min": float(np.min(e)), "p01": float(np.quantile(e, 0.01)), "p99": float(np.quantile(e, 0.99)), "max": float(np.max(e))},
        },
        "model_meta": {"standardize": zmeta},
        "notes": [
            "Interpretable baseline causal estimator. Assumes no unmeasured confounding.",
            "If overlap_rate is low, ATE may be unstable; consider trimming or better features.",
        ],
    }


