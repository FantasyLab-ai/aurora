from __future__ import annotations

from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import pandas as pd


def _to_numeric_frame(df: pd.DataFrame, cols: List[str]) -> pd.DataFrame:
    X = df[cols].copy()
    for c in cols:
        X[c] = pd.to_numeric(X[c], errors="coerce")
    X = X.replace([np.inf, -np.inf], np.nan)
    return X


def _safe_standardize(X: pd.DataFrame) -> Tuple[np.ndarray, Dict[str, Any]]:
    arr = X.to_numpy(dtype=float)
    mu = np.nanmean(arr, axis=0)
    sd = np.nanstd(arr, axis=0)
    sd = np.where((sd == 0) | ~np.isfinite(sd), 1.0, sd)
    Z = (arr - mu) / sd
    Z = np.where(np.isfinite(Z), Z, 0.0)
    meta = {"mu": mu.tolist(), "sd": sd.tolist()}
    return Z, meta


def _sigmoid(z: np.ndarray) -> np.ndarray:
    z = np.clip(z, -35, 35)
    return 1.0 / (1.0 + np.exp(-z))


def _fit_logistic_ridge(Z: np.ndarray, t: np.ndarray, l2: float = 1.0, iters: int = 600) -> np.ndarray:
    n, p = Z.shape
    w = np.zeros(p, dtype=float)
    lr = 0.1
    for _ in range(iters):
        p_hat = _sigmoid(Z @ w)
        grad = (Z.T @ (p_hat - t)) / n + l2 * w
        w -= lr * grad
    return w


def _fit_linear_ridge(Z: np.ndarray, y: np.ndarray, l2: float = 1.0) -> np.ndarray:
    n, p = Z.shape
    A = (Z.T @ Z) / n + l2 * np.eye(p)
    b = (Z.T @ y) / n
    w = np.linalg.solve(A, b)
    return w


def _bootstrap_ci(values: np.ndarray, alpha: float = 0.05, B: int = 600, seed: int = 0) -> Dict[str, Any]:
    rng = np.random.default_rng(seed)
    n = len(values)
    if n < 50:
        return {"note": "too_few_points_for_bootstrap"}
    means: List[float] = []
    for _ in range(B):
        idx = rng.integers(0, n, size=n)
        means.append(float(np.mean(values[idx])))
    lo = float(np.quantile(means, alpha / 2))
    hi = float(np.quantile(means, 1 - alpha / 2))
    return {"method": "bootstrap", "alpha": float(alpha), "B": int(B), "lo": lo, "hi": hi}


def estimate_ate_binary_dr(
    df: pd.DataFrame,
    treatment_col: str,
    outcome_col: str,
    covariate_cols: Optional[List[str]] = None,
    seed: int = 0,
) -> Dict[str, Any]:
    """
    Doubly-Robust AIPW ATE estimator.
    Requires treatment_col binary {0,1}. Outcome can be continuous.
    """

    if treatment_col not in df.columns or outcome_col not in df.columns:
        return {"error": "missing_required_columns"}

    t_raw = pd.to_numeric(df[treatment_col], errors="coerce")
    y_raw = pd.to_numeric(df[outcome_col], errors="coerce")

    if covariate_cols is None:
        num_cols = df.select_dtypes(include="number").columns.tolist()
        covariate_cols = [c for c in num_cols if c not in (treatment_col, outcome_col)]

    if not covariate_cols:
        return {"error": "no_covariates_available"}

    X = _to_numeric_frame(df, covariate_cols)
    m = t_raw.notna() & y_raw.notna()
    m = m & X.notna().any(axis=1)

    t = t_raw[m].astype(float).values
    y = y_raw[m].astype(float).values
    X = X.loc[m].fillna(X.median(numeric_only=True))

    t = np.where(t >= 0.5, 1.0, 0.0)
    n = int(len(t))
    if n < 200:
        return {"error": "too_few_rows", "n": n}

    Z, zmeta = _safe_standardize(X)

    w_e = _fit_logistic_ridge(Z, t, l2=1.0, iters=600)
    e = _sigmoid(Z @ w_e)
    e = np.clip(e, 0.02, 0.98)

    w0 = _fit_linear_ridge(Z[t == 0], y[t == 0], l2=1.0) if np.any(t == 0) else np.zeros(Z.shape[1])
    w1 = _fit_linear_ridge(Z[t == 1], y[t == 1], l2=1.0) if np.any(t == 1) else np.zeros(Z.shape[1])
    mu0 = Z @ w0
    mu1 = Z @ w1

    score = (mu1 - mu0) + (t * (y - mu1) / e) - ((1 - t) * (y - mu0) / (1 - e))
    ate = float(np.mean(score))

    ci = _bootstrap_ci(score, alpha=0.05, B=600, seed=seed)

    treat_rate = float(np.mean(t))
    overlap = float(np.mean((e > 0.05) & (e < 0.95)))

    return {
        "method": "ATE_DR_AIPW",
        "n": n,
        "treatment_col": treatment_col,
        "outcome_col": outcome_col,
        "covariates_n": int(len(covariate_cols)),
        "covariates_used": covariate_cols[:80],
        "ate": ate,
        "ci95": ci,
        "diagnostics": {
            "treatment_rate": treat_rate,
            "overlap_rate_e_between_0p05_0p95": overlap,
            "propensity": {
                "min": float(np.min(e)),
                "p01": float(np.quantile(e, 0.01)),
                "p99": float(np.quantile(e, 0.99)),
                "max": float(np.max(e)),
            },
        },
        "model_meta": {"standardize": zmeta},
        "notes": [
            "Interpretable baseline causal estimator. Assumes no unmeasured confounding.",
            "If overlap_rate is low, ATE may be unstable; consider trimming or better features.",
        ],
    }


def causal_what_if_linear(
    df: Any,
    treatment_col: Optional[str] = None,
    target_col: Optional[str] = None,
    outcome_col: Optional[str] = None,
    delta: float = 1.0,
    covariates: Optional[List[str]] = None,
    covariate_cols: Optional[List[str]] = None,
    feature_cols: Optional[List[str]] = None,
    min_rows: int = 200,
    **kwargs: Any,
) -> Dict[str, Any]:
    """
    Ultra-compatible "what-if" linear estimator.

    Accepts common parameter aliases:
      - target_col OR outcome_col
      - covariates OR covariate_cols OR feature_cols
    Ignores extra kwargs for compatibility with upstream callers.

    Fits OLS: target ~ 1 + treatment (+ optional covariates)
    Returns effect of +delta treatment.
    """
    if df is None:
        return {"error": "ValueError:df_is_none"}

    if not isinstance(df, pd.DataFrame):
        try:
            df = pd.DataFrame(df)
        except Exception as e:
            return {"error": f"TypeError:df_not_dataframe:{type(e).__name__}:{e}"}

    if target_col is None:
        target_col = outcome_col

    # Coerce object cols lightly (don’t trash non-numeric data unless coercible)
    for c in list(df.columns):
        if df[c].dtype == object:
            try:
                df[c] = pd.to_numeric(df[c], errors="ignore")
            except Exception:
                pass

    # Pick numeric columns
    numeric_cols = [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])]
    if not numeric_cols:
        # last attempt: hard coerce
        for c in list(df.columns):
            df[c] = pd.to_numeric(df[c], errors="coerce")
        numeric_cols = [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])]

    if not numeric_cols:
        return {"error": "ValueError:no_numeric_columns"}

    # Auto-pick target/treatment if missing
    if target_col is None or target_col not in df.columns or target_col not in numeric_cols:
        target_col = numeric_cols[0]

    if treatment_col is None or treatment_col not in df.columns or treatment_col not in numeric_cols or treatment_col == target_col:
        treatment_col = None
        for c in numeric_cols:
            if c != target_col:
                treatment_col = c
                break
        if treatment_col is None:
            return {"error": "ValueError:could_not_select_treatment_col", "target_col": target_col}

    # Controls alias resolution
    controls = covariates or covariate_cols or feature_cols or []
    controls = [c for c in controls if c in df.columns and c in numeric_cols and c not in (target_col, treatment_col)]

    # Build working frame (ONLY dropna on required cols; impute controls)
    cols = [target_col, treatment_col] + controls
    work = df[cols].copy()
    for c in cols:
        work[c] = pd.to_numeric(work[c], errors="coerce")

    work = work.replace([np.inf, -np.inf], np.nan)
    work = work.dropna(subset=[target_col, treatment_col])

    if len(work) < max(25, min_rows // 8):
        return {"error": f"ValueError:not_enough_rows_after_required_dropna:n={int(len(work))}", "target_col": target_col, "treatment_col": treatment_col}

    # Median-impute controls (stable; avoids collapsing to tiny n)
    if controls:
        med = work[controls].median(numeric_only=True)
        work[controls] = work[controls].fillna(med)

    if len(work) < 25:
        return {"error": f"ValueError:not_enough_rows:n={int(len(work))}", "target_col": target_col, "treatment_col": treatment_col}

    y = work[target_col].to_numpy(dtype=float)
    t = work[treatment_col].to_numpy(dtype=float)

    X_parts = [np.ones(len(work), dtype=float), t]
    for c in controls:
        X_parts.append(work[c].to_numpy(dtype=float))
    X = np.column_stack(X_parts)

    # Solve OLS robustly
    try:
        beta, *_ = np.linalg.lstsq(X, y, rcond=None)
    except Exception:
        lam = 1e-6
        XtX = X.T @ X
        Xty = X.T @ y
        beta = np.linalg.solve(XtX + lam * np.eye(XtX.shape[0]), Xty)

    b_treat = float(beta[1])
    return {
        "method": "WHAT_IF_LINEAR_OLS",
        "n": int(len(work)),
        "target_col": target_col,
        "treatment_col": treatment_col,
        "covariates_used": controls,
        "delta": float(delta),
        "beta_treatment": b_treat,
        "estimated_effect": float(b_treat * float(delta)),
        "note": "ok",
    }
