def _safe_to_numeric(s: pd.Series) -> pd.Series:
    try:
        return pd.to_numeric(s, errors="coerce")
    except Exception:
        return pd.Series([np.nan] * len(s), index=s.index)

def _find_datetime_cols(df: pd.DataFrame, max_cols: int = 60) -> List[str]:
    cols: List[str] = []
    for c in list(df.columns)[:max_cols]:
        if pd.api.types.is_datetime64_any_dtype(df[c]):
            cols.append(c); continue
        if pd.api.types.is_object_dtype(df[c]) or pd.api.types.is_string_dtype(df[c]):
            dt = pd.to_datetime(df[c], errors="coerce")
            if dt.notna().mean() > 0.6:
                cols.append(c)
    return cols

def _infer_target(df: pd.DataFrame) -> Optional[str]:
    # explicit names
    for c in df.columns:
        if not isinstance(c, str): 
            continue
        lc = c.lower()
        if lc in ("target","label","outcome","y"):
            return c
        if "injur" in lc or "fatal" in lc or "crash" == lc:
            return c
    # numeric w/ variance (skip IDs)
    best = None
    for c in df.columns:
        if not isinstance(c, str):
            continue
        lc = c.lower()
        if lc == "id" or lc.endswith("_id") or "uuid" in lc:
            continue
        s = _safe_to_numeric(df[c])
        if s.notna().mean() > 0.6 and s.nunique(dropna=True) > 10:
            v = float(s.var(skipna=True))
            if best is None or v > best[1]:
                best = (c, v)
    return best[0] if best else None

def _bootstrap_ci(values: np.ndarray, fn=np.mean, n: int = 300, alpha: float = 0.05, seed: int = 0) -> Dict[str, float]:
    rng = np.random.default_rng(seed)
    v = values[np.isfinite(values)]
    if v.size < 20:
        est = float(fn(v)) if v.size else float("nan")
        return {"n": float(v.size), "estimate": est, "lo": float("nan"), "hi": float("nan")}
    stats = []
    for _ in range(n):
        samp = rng.choice(v, size=v.size, replace=True)
        stats.append(fn(samp))
    stats = np.array(stats, dtype=float)
    return {
        "n": float(v.size),
        "estimate": float(fn(v)),
        "lo": float(np.quantile(stats, alpha/2)),
        "hi": float(np.quantile(stats, 1-alpha/2)),
    }

def _hypothesis_tests(df: pd.DataFrame, seed: int = 0) -> Dict[str, Any]:
    out: Dict[str, Any] = {"tests": []}
    num_cols = [c for c in df.columns if pd.api.types.is_numeric_dtype(df[c])]
    if sm is not None:
        for c in num_cols[:10]:
            x = df[c].dropna().astype(float)
            if len(x) >= 80:
                try:
                    jb = sm.stats.stattools.jarque_bera(x)
                    out["tests"].append({"type":"jarque_bera","col":str(c),"jb":float(jb[0]),"p":float(jb[1])})
                except Exception:
                    pass
    return out

def _dimensionality_reduction(df: pd.DataFrame, seed: int = 0) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    if PCA is None or SimpleImputer is None:
        out["note"] = "sklearn_not_available"; return out
    num = df.select_dtypes(include=["number"]).dropna(axis=1, how="all")
    if num.shape[1] < 3 or len(num) < 200:
        out["note"] = "not_enough_numeric_for_pca"; return out
    try:
        X = SimpleImputer(strategy="median").fit_transform(num)
        X = StandardScaler(with_mean=True).fit_transform(X)
        pca = PCA(n_components=min(10, X.shape[1]), random_state=seed)
        Z = pca.fit_transform(X)
        out["explained_variance_ratio"] = [float(v) for v in pca.explained_variance_ratio_[:10]]
        r = np.sqrt((Z[:, :min(5, Z.shape[1])]**2).sum(axis=1))
        out["pca_radius_ci"] = _bootstrap_ci(r.astype(float), fn=np.mean, seed=seed)
    except Exception as e:
        out["error"] = f"pca_failed:{type(e).__name__}:{e}"
    return out

def _regime_detection(df: pd.DataFrame) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    num = df.select_dtypes(include=["number"])
    if num.shape[1] == 0 or len(df) < 500:
        out["note"] = "not_enough_data"; return out
    vars_ = num.var(numeric_only=True).sort_values(ascending=False)
    c = vars_.index[0]
    s = pd.to_numeric(df[c], errors="coerce").dropna()
    if len(s) < 500:
        out["note"] = "not_enough_signal_points"; return out
    w = max(30, min(240, len(s)//30))
    rm = s.rolling(w).mean()
    rs = s.rolling(w).std()
    score = ((rm - rm.median()).abs().fillna(0) + (rs - rs.median()).abs().fillna(0)).to_numpy()
    idx = np.argsort(-score)[:10]
    out["signal_col"] = str(c)
    out["window"] = int(w)
    out["candidate_change_points_row_index"] = sorted([int(s.index[i]) for i in idx])
    return out

def _multivariate_and_assumptions(df: pd.DataFrame, target: Optional[str], seed: int = 0) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    if target is None:
        out["note"] = "no_target_inferred"; return out
    if ColumnTransformer is None:
        out["note"] = "sklearn_not_available"; return out

    y = df[target]
    X = df.drop(columns=[target], errors="ignore")
    y_num = _safe_to_numeric(y)
    is_class = (y_num.notna().mean() < 0.6)
    if not is_class:
        uniq = set(map(float, y_num.dropna().unique()[:10])) if len(y_num.dropna()) else set()
        if uniq.issubset({0.0, 1.0}):
            is_class = True

    num_cols = [c for c in X.columns if pd.api.types.is_numeric_dtype(X[c])]
    cat_cols = [c for c in X.columns if c not in num_cols]

    num_tf = Pipeline([("imp", SimpleImputer(strategy="median")), ("sc", StandardScaler(with_mean=False))])
    cat_tf = Pipeline([("imp", SimpleImputer(strategy="most_frequent")),
                       ("oh", OneHotEncoder(handle_unknown="ignore", sparse_output=True))])
    pre = ColumnTransformer([("num", num_tf, num_cols), ("cat", cat_tf, cat_cols)], remainder="drop")

    model = HistGradientBoostingClassifier(random_state=seed) if is_class else HistGradientBoostingRegressor(random_state=seed)
    pipe = Pipeline([("pre", pre), ("model", model)])

    try:
        Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=0.25, random_state=seed)
        pipe.fit(Xtr, ytr)
        pred = pipe.predict(Xte)
        if is_class:
            out["task"] = "classification"
            out["metrics"] = {"accuracy": float(accuracy_score(yte, pred))}
            try:
                proba = pipe.predict_proba(Xte)[:, 1]
                yb = pd.to_numeric(yte, errors="coerce")
                if yb.notna().mean() > 0.8:
                    out["metrics"]["roc_auc"] = float(roc_auc_score(yb, proba))
            except Exception:
                pass
        else:
            out["task"] = "regression"
            yt = pd.to_numeric(yte, errors="coerce")
            yp = pd.to_numeric(pd.Series(pred), errors="coerce")
            m = yt.notna() & yp.notna()
            if m.sum() >= 30:
                out["metrics"] = {"r2": float(r2_score(yt[m], yp[m])), "mae": float(mean_absolute_error(yt[m], yp[m]))}
                out["uncertainty_bootstrap_abs_error_ci"] = _bootstrap_ci(np.abs(yt[m].to_numpy()-yp[m].to_numpy()), fn=np.mean, seed=seed)
            else:
                out["note"] = "not_enough_numeric_points"
    except Exception as e:
        out["error"] = f"model_fit_failed:{type(e).__name__}:{e}"

    # OLS assumptions (numeric subset only)
    if sm is not None:
        try:
            yv = _safe_to_numeric(df[target])
            Xn = df.select_dtypes(include=["number"]).drop(columns=[target], errors="ignore")
            tmp = pd.concat([yv, Xn], axis=1).dropna()
            if len(tmp) >= 200 and 2 <= Xn.shape[1] <= 25:
                y_ = tmp[target].astype(float)
                X_ = sm.add_constant(tmp.drop(columns=[target]).astype(float), has_constant="add")
                fit = sm.OLS(y_, X_).fit()
                out["ols"] = {"n": int(len(tmp)), "k": int(X_.shape[1]), "r2": float(fit.rsquared)}
        except Exception:
            pass

    return out

def _causal_best_effort(df: pd.DataFrame) -> Dict[str, Any]:
    out: Dict[str, Any] = {"note":"best_effort"}
    dt_cols = _find_datetime_cols(df)
    if not dt_cols:
        out["note"] = "no_time_column"; return out
    treat = None
    for c in df.columns:
        if isinstance(c, str) and ("treat" in c.lower() or c.lower() in ("treated","post")):
            treat = c; break
    if treat is None:
        out["note"] = "no_treatment_column"; return out
    y = _infer_target(df)
    if y is None:
        out["note"] = "no_outcome"; return out
    if sm is None:
        out["note"] = "statsmodels_missing"; return out
    try:
        tcol = dt_cols[0]
        dt = pd.to_datetime(df[tcol], errors="coerce")
        cut = dt.dropna().median()
        post = (dt >= cut).astype(float)
        tr = pd.to_numeric(df[treat], errors="coerce")
        yy = _safe_to_numeric(df[y])
        tmp = pd.DataFrame({"y":yy,"treat":tr,"post":post}).dropna()
        if len(tmp) < 300:
            out["note"] = "not_enough_rows"; return out
        tmp["int"] = tmp["treat"]*tmp["post"]
        X = sm.add_constant(tmp[["treat","post","int"]], has_constant="add")
        fit = sm.OLS(tmp["y"], X).fit()
        out["did"] = {
            "time_col": str(tcol),
            "treatment_col": str(treat),
            "outcome_col": str(y),
            "cut_date": str(cut),
            "coef_int": float(fit.params.get("int", float("nan"))),
            "p_int": float(fit.pvalues.get("int", float("nan"))),
            "n": int(len(tmp)),
        }
    except Exception as e:
        out["error"] = f"did_failed:{type(e).__name__}:{e}"
    return out

def compute_deep_math_v1(df: pd.DataFrame, seed: int = 0) -> Dict[str, Any]:
    out: Dict[str, Any] = {"rows": int(df.shape[0]), "cols": int(df.shape[1])}
    work = df.dropna(axis=1, how="all").copy()
    target = _infer_target(work)
    out["target_inferred"] = target
    out["hypothesis"] = _hypothesis_tests(work, seed=seed)
    out["multivariate"] = _multivariate_and_assumptions(work, target=target, seed=seed)
    out["dimensionality_reduction"] = _dimensionality_reduction(work, seed=seed)
    out["regime_detection"] = _regime_detection(work)
    out["causal_inference"] = _causal_best_effort(work)
    return out