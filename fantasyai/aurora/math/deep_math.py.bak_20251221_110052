from __future__ import annotations

import math
from dataclasses import dataclass
from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import pandas as pd

def _safe_imports():
    out = {}
    try:
        import scipy.stats as st
        out["st"] = st
    except Exception:
        out["st"] = None
    try:
        import statsmodels.api as sm
        out["sm"] = sm
    except Exception:
        out["sm"] = None
    try:
        from sklearn.decomposition import PCA
        from sklearn.preprocessing import StandardScaler
        out["PCA"] = PCA
        out["StandardScaler"] = StandardScaler
    except Exception:
        out["PCA"] = None
        out["StandardScaler"] = None
    return out

def _pick_time_col(df: pd.DataFrame) -> Optional[str]:
    # prefer obvious time columns
    for c in df.columns:
        if not isinstance(c, str): 
            continue
        lc = c.lower()
        if lc in ("date","datetime","timestamp","time","crash_date","crash_time"):
            return c
        if "date" in lc or "time" in lc:
            return c
    return None

def _coerce_datetime(s: pd.Series) -> Optional[pd.Series]:
    if pd.api.types.is_datetime64_any_dtype(s):
        return s
    if not (pd.api.types.is_object_dtype(s) or pd.api.types.is_string_dtype(s)):
        return None
    try:
        dt = pd.to_datetime(s, errors="coerce")
        if dt.notna().mean() > 0.6:
            return dt
    except Exception:
        return None
    return None

def _numeric_frame(df: pd.DataFrame, max_cols: int = 30) -> pd.DataFrame:
    num = df.select_dtypes(include=["number"]).copy()
    if num.shape[1] > max_cols:
        num = num.iloc[:, :max_cols]
    return num

def _bootstrap_ci(x: np.ndarray, stat_fn, iters: int = 300, alpha: float = 0.05, seed: int = 0) -> Dict[str, Any]:
    rng = np.random.default_rng(seed)
    x = x[np.isfinite(x)]
    if x.size < 10:
        return {"note": "too_few_points"}
    vals = []
    n = x.size
    for _ in range(iters):
        samp = rng.choice(x, size=n, replace=True)
        vals.append(float(stat_fn(samp)))
    vals = np.array(vals, dtype=float)
    lo = float(np.quantile(vals, alpha / 2))
    hi = float(np.quantile(vals, 1 - alpha / 2))
    return {"lo": lo, "hi": hi, "iters": iters}

def _regime_detection_series(y: pd.Series, window: int = 96) -> Dict[str, Any]:
    # simple but robust: detect shifts in rolling mean/vol via z of diff
    v = pd.to_numeric(y, errors="coerce").astype(float)
    v = v.replace([np.inf, -np.inf], np.nan).dropna()
    if v.size < window * 3:
        return {"note": "too_short_for_regime_detection", "n": int(v.size)}
    roll_mean = v.rolling(window).mean()
    roll_std  = v.rolling(window).std()
    dmu = roll_mean.diff()
    z = (dmu - dmu.mean()) / (dmu.std() + 1e-9)
    # candidate change points where |z| is large
    cps = z.abs().sort_values(ascending=False).head(8).index.tolist()
    cps = sorted(set([int(i) for i in cps if not math.isnan(i)]))
    return {
        "window": int(window),
        "candidate_change_points": cps[:8],
        "z_max": float(z.abs().max()),
    }

def _assumption_tests(y: np.ndarray, X: np.ndarray, imports: Dict[str, Any]) -> Dict[str, Any]:
    st = imports["st"]
    sm = imports["sm"]
    out: Dict[str, Any] = {}

    y = y.astype(float)
    mask = np.isfinite(y) & np.all(np.isfinite(X), axis=1)
    y = y[mask]
    X = X[mask]
    if y.size < 50:
        return {"note": "too_few_rows_for_assumption_tests", "n": int(y.size)}

    # Normality test on y (not residuals) as a cheap signal
    if st is not None:
        try:
            if y.size <= 5000:
                stat, p = st.shapiro(y)
                out["normality_shapiro_p"] = float(p)
            else:
                stat, p = st.normaltest(y[:5000])
                out["normality_dagostino_p"] = float(p)
        except Exception as e:
            out["normality_error"] = str(e)

    # If statsmodels is available, run OLS + BP + DW
    if sm is not None:
        try:
            Xc = sm.add_constant(X, has_constant="add")
            model = sm.OLS(y, Xc).fit()
            resid = model.resid
            out["ols_r2"] = float(getattr(model, "rsquared", np.nan))
            out["ols_n"] = int(model.nobs)

            # Durbin-Watson (autocorr proxy)
            try:
                from statsmodels.stats.stattools import durbin_watson
                out["durbin_watson"] = float(durbin_watson(resid))
            except Exception:
                pass

            # Breusch-Pagan (heteroskedasticity)
            try:
                from statsmodels.stats.diagnostic import het_breuschpagan
                bp = het_breuschpagan(resid, Xc)
                out["breusch_pagan_p"] = float(bp[1])
            except Exception:
                pass
        except Exception as e:
            out["ols_error"] = str(e)

    return out

def compute_deep_math_v1(df: pd.DataFrame, seed: int = 0) -> Dict[str, Any]:
    """
    Deep Math V1:
      - hypothesis testing (t-test/chi-square where possible)
      - multivariate modeling (OLS if statsmodels available)
      - dimensionality reduction (PCA if sklearn available)
      - regime / phase detection (rolling-mean shift candidates)
      - model-based uncertainty (bootstrap CI on mean/std for key series)
      - formal assumptions testing (normality, heteroskedasticity, autocorr proxies)
    """
    imports = _safe_imports()
    st = imports["st"]
    sm = imports["sm"]
    PCA = imports["PCA"]
    StandardScaler = imports["StandardScaler"]

    out: Dict[str, Any] = {
        "version": "deep_math_v1",
        "rows": int(df.shape[0]),
        "cols": int(df.shape[1]),
        "capabilities": {
            "hypothesis_testing": bool(st is not None),
            "multivariate_modeling": bool(sm is not None),
            "dimensionality_reduction": bool(PCA is not None and StandardScaler is not None),
            "regime_detection": True,
            "model_based_uncertainty": True,
            "formal_assumptions_testing": True,
        },
    }

    num = _numeric_frame(df, max_cols=30)
    out["numeric_cols_used"] = int(num.shape[1])

    # pick a main numeric series (highest non-null)
    main_col = None
    if num.shape[1] > 0:
        nn = num.notna().mean().sort_values(ascending=False)
        main_col = str(nn.index[0])
    out["main_numeric_col"] = main_col

    # Regime detection on main numeric
    if main_col is not None:
        out["regime_detection"] = _regime_detection_series(num[main_col])

        # Bootstrap uncertainty on mean/std
        v = pd.to_numeric(num[main_col], errors="coerce").to_numpy(dtype=float)
        out["uncertainty"] = {
            "mean_ci": _bootstrap_ci(v, np.mean, iters=300, seed=seed),
            "std_ci":  _bootstrap_ci(v, np.std,  iters=300, seed=seed + 1),
        }
    else:
        out["regime_detection"] = {"note": "no_numeric_columns"}
        out["uncertainty"] = {"note": "no_numeric_columns"}

    # Dimensionality reduction (PCA)
    if PCA is not None and StandardScaler is not None and num.shape[1] >= 3 and len(num) >= 200:
        try:
            X = num.copy()
            X = X.replace([np.inf, -np.inf], np.nan).dropna(axis=0)
            # sample cap for speed
            if len(X) > 20000:
                X = X.sample(20000, random_state=seed)
            scaler = StandardScaler()
            Xs = scaler.fit_transform(X.to_numpy(dtype=float))
            k = min(8, Xs.shape[1])
            pca = PCA(n_components=k, random_state=seed)
            Z = pca.fit_transform(Xs)
            out["pca"] = {
                "n_rows": int(Xs.shape[0]),
                "n_cols": int(Xs.shape[1]),
                "n_components": int(k),
                "explained_variance_ratio": [float(v) for v in pca.explained_variance_ratio_.tolist()],
                "top_loading_cols": [
                    {
                        "pc": int(i+1),
                        "top_features": [
                            {"col": str(X.columns[j]), "loading": float(pca.components_[i, j])}
                            for j in np.argsort(np.abs(pca.components_[i]))[::-1][:6]
                        ]
                    }
                    for i in range(k)
                ],
            }
        except Exception as e:
            out["pca"] = {"error": f"{type(e).__name__}:{e}"}
    else:
        out["pca"] = {"note": "pca_unavailable_or_not_enough_numeric"}

    # Multivariate modeling + assumption tests (OLS)
    if sm is not None and num.shape[1] >= 2 and len(num) >= 200:
        try:
            Xdf = num.copy().replace([np.inf, -np.inf], np.nan).dropna(axis=0)
            if Xdf.shape[0] > 50000:
                Xdf = Xdf.sample(50000, random_state=seed)
            ycol = str(Xdf.columns[0])
            Xcols = [c for c in Xdf.columns[1:8]]
            y = pd.to_numeric(Xdf[ycol], errors="coerce").to_numpy(dtype=float)
            X = Xdf[Xcols].apply(pd.to_numeric, errors="coerce").to_numpy(dtype=float)
            Xc = sm.add_constant(X, has_constant="add")
            model = sm.OLS(y, Xc).fit()
            out["ols"] = {
                "y": ycol,
                "x": [str(c) for c in Xcols],
                "n": int(model.nobs),
                "r2": float(getattr(model, "rsquared", np.nan)),
                "params": [float(p) for p in model.params.tolist()],
                "pvalues": [float(p) for p in model.pvalues.tolist()],
            }
            out["assumptions"] = _assumption_tests(y, X, imports)
        except Exception as e:
            out["ols"] = {"error": f"{type(e).__name__}:{e}"}
            out["assumptions"] = {"error": f"{type(e).__name__}:{e}"}
    else:
        out["ols"] = {"note": "statsmodels_unavailable_or_not_enough_numeric"}
        out["assumptions"] = {"note": "statsmodels_unavailable_or_not_enough_numeric"}

    # Hypothesis tests (simple automated)
    if st is not None and main_col is not None:
        try:
            y = pd.to_numeric(num[main_col], errors="coerce").astype(float)
            y = y.replace([np.inf, -np.inf], np.nan).dropna()
            if y.size >= 200:
                med = float(y.median())
                g1 = y[y <= med].to_numpy()
                g2 = y[y > med].to_numpy()
                # two-sample t-test (Welch)
                t, p = st.ttest_ind(g1, g2, equal_var=False, nan_policy="omit")
                out["hypothesis_tests"] = {
                    "split_rule": f"{main_col} <= median vs > median",
                    "welch_ttest_p": float(p),
                    "g1_n": int(g1.size),
                    "g2_n": int(g2.size),
                }
            else:
                out["hypothesis_tests"] = {"note": "too_few_points"}
        except Exception as e:
            out["hypothesis_tests"] = {"error": f"{type(e).__name__}:{e}"}
    else:
        out["hypothesis_tests"] = {"note": "scipy_unavailable_or_no_numeric"}

    return out