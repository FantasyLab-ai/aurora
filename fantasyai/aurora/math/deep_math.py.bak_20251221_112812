from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, Optional, Tuple, List

import numpy as np
import pandas as pd

# Optional deps: statsmodels, sklearn. If missing, we degrade gracefully.
try:
    import statsmodels.api as sm
except Exception:
    sm = None

try:
    from sklearn.decomposition import PCA
    from sklearn.preprocessing import StandardScaler
    from sklearn.cluster import KMeans
except Exception:
    PCA = None
    StandardScaler = None
    KMeans = None


def _numeric_df(df: pd.DataFrame) -> pd.DataFrame:
    out = df.copy()
    for c in out.columns:
        # keep numeric; coerce strings that look numeric
        out[c] = pd.to_numeric(out[c], errors="coerce")
    out = out.select_dtypes(include="number")
    # drop all-NaN columns
    out = out.dropna(axis=1, how="all")
    return out


def _safe_corr(num: pd.DataFrame, max_cols: int = 40) -> List[Dict[str, Any]]:
    if num.shape[1] < 2:
        return []
    cols = list(num.columns[:max_cols])
    corr = num[cols].corr(numeric_only=True)
    pairs = []
    for i in range(len(cols)):
        for j in range(i + 1, len(cols)):
            v = corr.iloc[i, j]
            if pd.notna(v):
                pairs.append((cols[i], cols[j], float(v)))
    pairs.sort(key=lambda t: abs(t[2]), reverse=True)
    return [{"a": a, "b": b, "corr": v} for a, b, v in pairs[:30]]


def _ttest_onesample(x: np.ndarray, mu: float = 0.0) -> Optional[Dict[str, Any]]:
    # simple z-approx if scipy not available
    x = x[np.isfinite(x)]
    if x.size < 20:
        return None
    m = float(x.mean())
    s = float(x.std(ddof=1))
    if s == 0:
        return None
    se = s / np.sqrt(x.size)
    t = (m - mu) / se
    # normal approx p-value
    # (good enough for “engine room”; we can upgrade to scipy later)
    from math import erf, sqrt
    p = 2.0 * (1.0 - 0.5 * (1.0 + erf(abs(t) / sqrt(2.0))))
    return {"n": int(x.size), "mean": m, "std": s, "t_stat_approx": float(t), "p_value_approx": float(p)}


def _ols(num: pd.DataFrame, ycol: str, xcols: List[str]) -> Optional[Dict[str, Any]]:
    if sm is None:
        return {"error": "statsmodels_missing"}
    y = num[ycol].astype(float)
    X = num[xcols].astype(float)
    # drop rows with NaNs
    m = pd.concat([y, X], axis=1).dropna()
    if m.shape[0] < 50:
        return None
    y2 = m[ycol].values
    X2 = m[xcols].values
    X2 = sm.add_constant(X2, has_constant="add")
    model = sm.OLS(y2, X2).fit()
    coef = model.params
    # pack coefficients (const + xcols)
    names = ["const"] + list(xcols)
    coefs = [{"name": n, "coef": float(c)} for n, c in zip(names, coef)]
    return {
        "n": int(m.shape[0]),
        "r2": float(getattr(model, "rsquared", np.nan)),
        "adj_r2": float(getattr(model, "rsquared_adj", np.nan)),
        "aic": float(getattr(model, "aic", np.nan)),
        "bic": float(getattr(model, "bic", np.nan)),
        "coef": coefs[:25],
    }


def _pca(num: pd.DataFrame, k: int = 5) -> Optional[Dict[str, Any]]:
    if PCA is None or StandardScaler is None:
        return {"error": "sklearn_missing"}
    m = num.dropna()
    if m.shape[0] < 100 or m.shape[1] < 3:
        return None
    X = StandardScaler().fit_transform(m.values)
    k = int(min(k, m.shape[1], 10))
    p = PCA(n_components=k, random_state=0)
    Z = p.fit_transform(X)
    return {
        "n": int(m.shape[0]),
        "components": int(k),
        "explained_variance_ratio": [float(v) for v in p.explained_variance_ratio_],
        "top_loading_features": [
            {
                "pc": int(i+1),
                "top": [
                    {"feature": m.columns[j], "loading": float(p.components_[i, j])}
                    for j in np.argsort(np.abs(p.components_[i]))[::-1][:8]
                ],
            }
            for i in range(k)
        ],
    }


def _regime_kmeans(num: pd.DataFrame, k: int = 3) -> Optional[Dict[str, Any]]:
    if KMeans is None or StandardScaler is None:
        return {"error": "sklearn_missing"}
    m = num.dropna()
    if m.shape[0] < 300 or m.shape[1] < 3:
        return None
    use = m.iloc[:, : min(8, m.shape[1])]
    X = StandardScaler().fit_transform(use.values)
    k = int(max(2, min(k, 6)))
    km = KMeans(n_clusters=k, n_init=10, random_state=0)
    lab = km.fit_predict(X)
    counts = pd.Series(lab).value_counts().sort_index()
    return {
        "k": int(k),
        "features_used": list(use.columns),
        "cluster_counts": [{"cluster": int(i), "count": int(counts.loc[i])} for i in counts.index],
    }


def compute_deep_math_v1(df: pd.DataFrame, seed: int = 0) -> Dict[str, Any]:
    np.random.seed(int(seed))
    out: Dict[str, Any] = {"meta": {"seed": int(seed)}}

    num = _numeric_df(df)
    out["numeric_cols"] = int(num.shape[1])
    out["rows_numeric_completecase"] = int(num.dropna().shape[0])

    out["top_correlations"] = _safe_corr(num)

    # Hypothesis tests: one-sample test of mean != 0 for each numeric col (approx)
    tests = {}
    for c in list(num.columns)[:25]:
        t = _ttest_onesample(num[c].values, mu=0.0)
        if t is not None:
            tests[c] = t
    out["hypothesis_tests"] = tests

    # Multivariate modeling: pick a target as the most “connected” numeric col (highest avg abs corr)
    target = None
    if num.shape[1] >= 3:
        corr = num.iloc[:, : min(25, num.shape[1])].corr(numeric_only=True).abs()
        avg = corr.mean(axis=0).sort_values(ascending=False)
        target = str(avg.index[0])
    out["target_guess"] = target

    if target is not None:
        xcols = [c for c in num.columns if c != target][: min(10, max(2, num.shape[1]-1))]
        out["ols"] = _ols(num, target, xcols)

    out["pca"] = _pca(num, k=5)
    out["regimes"] = _regime_kmeans(num, k=3)

    # Model-based uncertainty (simple bootstrap of mean of top target)
    if target is not None:
        x = pd.to_numeric(num[target], errors="coerce").dropna().values
        if x.size >= 200:
            B = 400
            idx = np.random.randint(0, x.size, size=(B, x.size))
            means = x[idx].mean(axis=1)
            out["uncertainty_bootstrap_mean"] = {
                "n": int(x.size),
                "bootstraps": int(B),
                "mean": float(x.mean()),
                "ci95": [float(np.percentile(means, 2.5)), float(np.percentile(means, 97.5))],
            }

    return out