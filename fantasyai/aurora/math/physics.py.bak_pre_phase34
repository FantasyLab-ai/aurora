from __future__ import annotations

import math
from dataclasses import dataclass
from typing import Any, Dict, Optional, Tuple, Union

import numpy as np
import pandas as pd


# -----------------------------
# Phase 2: Robust time-axis inference
# -----------------------------

TIME_HINTS = ("date", "time", "timestamp", "datetime", "dt", "utc")


def _is_mostly_numeric(s: pd.Series, thresh: float = 0.90) -> bool:
    """
    True if the series can be coerced to numeric at a high rate.
    This is used to prevent sensor columns (CO, NO2, etc.) from being treated as time.
    """
    if s is None or len(s) == 0:
        return False
    x = pd.to_numeric(s, errors="coerce")
    ok = float(np.isfinite(x.to_numpy(dtype=float, copy=False)).mean())
    return ok >= thresh


def _parse_datetime_series(raw: pd.Series, dayfirst_hint: bool = True) -> pd.Series:
    """
    Try hard to parse timestamps from an object/string series.
    Uses two passes (dayfirst True/False) and returns the best parse.
    """
    s = raw.astype(str).str.strip()
    # common cleanup: commas in numbers, weird whitespace
    s = s.str.replace("\u00a0", " ", regex=False)

    dt1 = pd.to_datetime(s, errors="coerce", dayfirst=dayfirst_hint)
    r1 = float(dt1.notna().mean())

    dt2 = pd.to_datetime(s, errors="coerce", dayfirst=not dayfirst_hint)
    r2 = float(dt2.notna().mean())

    return dt1 if r1 >= r2 else dt2


def _combine_date_time(date_s: pd.Series, time_s: pd.Series) -> pd.Series:
    """
    Combine Date + Time columns into a single datetime.
    Handles AirQualityUCI's time like '18.00.00' by converting '.' -> ':'.
    """
    d = date_s.astype(str).str.strip()
    t = time_s.astype(str).str.strip()

    # normalize common scientific formats
    t = t.str.replace(".", ":", regex=False)

    comb = (d + " " + t).str.strip()

    # try dayfirst first (EU style datasets), then fallback
    dt = pd.to_datetime(comb, errors="coerce", dayfirst=True)
    if float(dt.notna().mean()) < 0.85:
        dt2 = pd.to_datetime(comb, errors="coerce", dayfirst=False)
        if float(dt2.notna().mean()) > float(dt.notna().mean()):
            dt = dt2
    return dt


def _infer_time_col(df: pd.DataFrame) -> Optional[Union[str, Tuple[str, str]]]:
    """
    Return:
      - (date_col, time_col) if a Date+Time pair is found
      - a single column name if a strong datetime column is found
      - None if nothing credible exists
    """
    cols = list(df.columns)
    lower = {c: str(c).strip().lower() for c in cols}

    # 1) Prefer explicit Date+Time pair
    date_candidates = [c for c in cols if "date" in lower[c]]
    time_candidates = [c for c in cols if lower[c] == "time" or ("time" in lower[c] and "datetime" not in lower[c])]

    for dc in date_candidates:
        for tc in time_candidates:
            if dc == tc:
                continue
            # Avoid numeric columns masquerading as date/time
            if _is_mostly_numeric(df[dc]) or _is_mostly_numeric(df[tc]):
                continue
            dt = _combine_date_time(df[dc], df[tc])
            if float(dt.notna().mean()) >= 0.85:
                return (dc, tc)

    # 2) Single datetime-like column by name hints
    hinted = [c for c in cols if any(h in lower[c] for h in TIME_HINTS)]
    hinted = [c for c in hinted if not _is_mostly_numeric(df[c])]
    for c in hinted:
        dt = _parse_datetime_series(df[c], dayfirst_hint=True)
        if float(dt.notna().mean()) >= 0.85:
            return c

    # 3) Fallback: scan object columns with high datetime parse rate
    obj_cols = [c for c in cols if df[c].dtype == object and not _is_mostly_numeric(df[c])]
    best_c = None
    best_rate = 0.0
    for c in obj_cols[:50]:
        dt = _parse_datetime_series(df[c], dayfirst_hint=True)
        rate = float(dt.notna().mean())
        if rate > best_rate:
            best_rate = rate
            best_c = c
    if best_c is not None and best_rate >= 0.90:
        return best_c

    return None


def _robust_dt_seconds(dt: pd.Series) -> float:
    """
    Estimate timestep seconds using median non-zero differences.
    """
    if dt is None:
        return 1.0
    d = dt.dropna().sort_values()
    if len(d) < 3:
        return 1.0
    diffs = d.diff().dropna()
    diffs = diffs[diffs > pd.Timedelta(0)]
    if len(diffs) == 0:
        return 1.0
    med = diffs.median()
    sec = float(med.total_seconds())
    return sec if np.isfinite(sec) and sec > 0 else 1.0


def _get_time_series(
    df: pd.DataFrame,
    time_col: Optional[Union[str, Tuple[str, str]]] = None,
) -> Tuple[pd.Series, str, float]:
    """
    Returns: (datetime_series_or_fallback, time_axis_name, dt_seconds)
    """
    if time_col is None:
        time_col = _infer_time_col(df)

    if isinstance(time_col, tuple) and len(time_col) == 2:
        dc, tc = time_col
        dt = _combine_date_time(df[dc], df[tc])
        axis = f"{dc}+{tc}"
        dt_seconds = _robust_dt_seconds(dt)
        if float(dt.notna().mean()) >= 0.50:
            return dt, axis, dt_seconds

    if isinstance(time_col, str) and time_col in df.columns:
        dt = _parse_datetime_series(df[time_col], dayfirst_hint=True)
        axis = str(time_col)
        dt_seconds = _robust_dt_seconds(dt)
        if float(dt.notna().mean()) >= 0.50:
            return dt, axis, dt_seconds

    # fallback: synthetic index
    n = len(df)
    dt = pd.to_datetime(pd.RangeIndex(n), unit="s", origin="unix", errors="coerce")
    return dt, "fallback_index", 1.0


# -----------------------------
# Minimal physics primitive used by discovery
# dy/dt = a*y + b
# -----------------------------

def fit_first_order_ode(y: np.ndarray, dt_seconds: float) -> Dict[str, Any]:
    """
    Fits dy/dt = a*y + b using least squares on finite differences.
    """
    y = np.asarray(y, dtype=float)
    if len(y) < 10 or not np.isfinite(dt_seconds) or dt_seconds <= 0:
        return {"note": "insufficient_data", "error": "too_short_or_bad_dt"}

    dy = np.diff(y) / float(dt_seconds)
    y_mid = y[:-1]

    mask = np.isfinite(dy) & np.isfinite(y_mid)
    dy = dy[mask]
    y_mid = y_mid[mask]
    if len(dy) < 10:
        return {"note": "insufficient_data", "error": "too_few_finite"}

    # Solve dy = a*y + b
    A = np.column_stack([y_mid, np.ones_like(y_mid)])
    coef, *_ = np.linalg.lstsq(A, dy, rcond=None)
    a, b = float(coef[0]), float(coef[1])

    pred = A @ np.array([a, b])
    resid = dy - pred
    ss_res = float(np.sum(resid ** 2))
    ss_tot = float(np.sum((dy - float(np.mean(dy))) ** 2)) + 1e-12
    r2 = 1.0 - ss_res / ss_tot

    rmse = float(np.sqrt(np.mean(resid ** 2))) if len(resid) else float("nan")
    stable = a < 0.0
    tau = (1.0 / abs(a)) if stable and abs(a) > 1e-12 else float("inf")

    return {
        "note": "ok",
        "error": None,
        "model": "dy_dt = a*y + b",
        "a": a,
        "b": b,
        "stable": bool(stable),
        "time_constant_seconds": float(tau),
        "r2": float(r2),
        "rmse": float(rmse),
        "n": int(len(y_mid)),
    }


def physics_primitive(df: pd.DataFrame, target_col: str, time_col: Optional[Union[str, Tuple[str, str]]] = None) -> Dict[str, Any]:
    """
    High-level helper: build time axis, estimate dt, fit primitive ODE.
    """
    out: Dict[str, Any] = {"note": "ok", "error": None}
    try:
        dt, axis, dt_seconds = _get_time_series(df, time_col=time_col)
        y = pd.to_numeric(df[target_col], errors="coerce").to_numpy(dtype=float, copy=False)
        y = y[np.isfinite(y)]
        fit = fit_first_order_ode(y, dt_seconds)
        out.update(fit)
        out["time_axis"] = axis
        out["dt_seconds"] = float(dt_seconds)
        out["time_col"] = target_col if axis == "fallback_index" else axis
        return out
    except Exception as e:
        out["note"] = "error"
        out["error"] = str(e)
        return out
