{
  "id": "economics",
  "version": "v1",
  "display_name": "Economics / macro indicators",
  "domain_tag": "economics",
  "description": "GDP, employment, inflation, rates, exchange rates, sentiment. Regime transitions (expansion/contraction), lag transmission, leading-indicator divergences, structural breaks, term-structure inversions.",
  "identification": {
    "column_keywords": [
      "gdp", "gdpc1", "gdp_per_capita",
      "unemployment", "unemp", "unrate", "u3", "u6",
      "cpi", "cpiaucsl", "core_cpi", "ppi", "pce", "core_pce",
      "inflation", "inflation_rate",
      "fed_funds", "ffr", "policy_rate",
      "yield", "treasury", "t10y", "t3m", "t2y", "t10y3m", "t10y2y", "term_spread",
      "exchange_rate", "fx", "usd", "dxy", "trade_weighted",
      "m1", "m2", "money_supply",
      "industrial_production", "indpro", "capacity_utilization",
      "consumer_sentiment", "umcsent", "consumer_confidence",
      "ism", "pmi", "manufacturing_pmi", "services_pmi",
      "housing_starts", "building_permits", "case_shiller",
      "retail_sales", "personal_income", "personal_spending",
      "trade_balance", "current_account", "exports", "imports"
    ],
    "value_range_hints": {
      "unemployment": [0, 30],
      "unrate":       [0, 30],
      "cpi":          [-5, 30],
      "inflation":    [-5, 30],
      "fed_funds":    [0, 25],
      "ffr":          [0, 25]
    },
    "cadence_hints": ["daily", "weekly", "monthly", "quarterly"],
    "domain_tags": ["economics", "macro"],
    "min_keyword_hits": 2
  },
  "topology_skeleton": {
    "entities": [
      {"id": "leading",     "label": "Leading indicator",    "role": "indicator"},
      {"id": "coincident",  "label": "Coincident indicator", "role": "state"},
      {"id": "lagging",     "label": "Lagging indicator",    "role": "response"},
      {"id": "policy_rate", "label": "Policy rate",          "role": "forcing"},
      {"id": "term_struct", "label": "Term structure",       "role": "indicator"},
      {"id": "inflation",   "label": "Inflation",            "role": "state"},
      {"id": "shock",       "label": "Shock",                "role": "exogenous"}
    ],
    "expected_relationships": [
      {"id": "rel_lead_coinc",  "source": "leading",     "target": "coincident",  "kind": "lagged",     "rationale": "Leading indicators precede coincident by 3-9 months."},
      {"id": "rel_coinc_lag",   "source": "coincident",  "target": "lagging",     "kind": "lagged",     "rationale": "Coincident → lagging at 3-12 months."},
      {"id": "rel_policy_term", "source": "policy_rate", "target": "term_struct", "kind": "causal",     "rationale": "Short rate moves anchor the curve."},
      {"id": "rel_policy_inf",  "source": "policy_rate", "target": "inflation",   "kind": "lagged",     "rationale": "Policy transmission lag 6-18 months."},
      {"id": "rel_inf_lead",    "source": "inflation",   "target": "leading",     "kind": "feedback",   "rationale": "Inflation expectations feed leading indicators."}
    ]
  },
  "characteristic_patterns": [
    {"id": "regime_recession",
     "name": "Recession regime",
     "signature": "NBER-style coincident downturn + leading-index decline",
     "detection_rule": "coincident_change < 0 over 2+ quarters AND leading_index_change < 0"},
    {"id": "term_inversion",
     "name": "Term-structure inversion",
     "signature": "long-rate < short-rate (10y - 3m or 10y - 2y < 0)",
     "detection_rule": "yield_10y - yield_3m < 0 sustained ≥ 30 days"},
    {"id": "lag_transmission",
     "name": "Lag transmission",
     "signature": "cross-correlation between indicator pair peaks at non-zero lag",
     "detection_rule": "abs(corr@lag>0) > corr@0 for known leading→lagging pair"},
    {"id": "structural_break",
     "name": "Structural break",
     "signature": "PELT change-point on multi-indicator regime",
     "detection_rule": "ruptures change-point detected on ≥ 2 indicators within window"},
    {"id": "leading_divergence",
     "name": "Leading-indicator divergence",
     "signature": "normally co-moving leading indicators disagree",
     "detection_rule": "sign(leading_a) != sign(leading_b) sustained over 2+ months"},
    {"id": "policy_pivot",
     "name": "Policy pivot",
     "signature": "step change in policy_rate trajectory",
     "detection_rule": "change-point detected on policy_rate AND magnitude > 0.25"}
  ],
  "vocabulary": {
    "anomaly_term": "data surprise",
    "regime_term": "regime",
    "pattern_term": "macro signature",
    "action_term": "policy / portfolio response",
    "breach_term": "regime entry",
    "advisory_term": "macro note",
    "extra": {"high_state": "expansion", "low_state": "contraction", "transition": "regime shift"}
  },
  "action_library": [
    {"id": "forecast_trajectory",
     "label": "Forecast indicator trajectory",
     "description": "Project the indicator forward via AR + factor model; surface regime probability with calibrated CI.",
     "triggered_when": ["coincident or leading indicator surfaced"],
     "predicted_outcome_summary": "AR(p) + factor models capture ~60% of macro indicator variance at 1-3 month horizons.",
     "base_rate_success": 0.6,
     "confidence_band_required": "medium",
     "falsification": ["forecast CI fails to bracket realised value 30%+ of the time"],
     "assumptions": ["regime stability over horizon", "no large unmodelled shock"],
     "relevant_states": ["lag_transmission"]},
    {"id": "flag_regime_transition",
     "label": "Flag regime entry / exit",
     "description": "When detection_rule fires for recession_regime or term_inversion, surface as a decision-grade signal.",
     "triggered_when": ["regime_recession", "term_inversion"],
     "predicted_outcome_summary": "Term inversions precede recessions by 6-18 months in 7 of last 8 US cycles.",
     "base_rate_success": 0.7,
     "confidence_band_required": "medium",
     "falsification": ["inversion does not precede a recession within 24 months"],
     "assumptions": ["historical analogues hold"],
     "relevant_states": ["regime_recession", "term_inversion"]},
    {"id": "monitor_leading_dispersion",
     "label": "Monitor leading-indicator dispersion",
     "description": "When leading indicators diverge, surface for further investigation rather than acting.",
     "triggered_when": ["leading_divergence"],
     "predicted_outcome_summary": "Leading-indicator divergence resolves to a regime shift in ~50% of cases — explicitly low confidence.",
     "base_rate_success": 0.5,
     "confidence_band_required": "low",
     "falsification": [],
     "assumptions": [],
     "relevant_states": ["leading_divergence"]},
    {"id": "investigate_break",
     "label": "Investigate structural break",
     "description": "PELT-detected breaks across multi-indicator regimes are flagged for human review (not auto-decision).",
     "triggered_when": ["structural_break"],
     "predicted_outcome_summary": "Structural breaks reflect real regime change in ~65% of cases; the rest are measurement / methodology shifts.",
     "base_rate_success": 0.65,
     "confidence_band_required": "medium",
     "falsification": ["break attributable to data revision rather than economy"],
     "assumptions": [],
     "relevant_states": ["structural_break"]}
  ],
  "constraints": [
    {"id": "unemp_pos",   "description": "unemployment ≥ 0",            "kind": "bound", "hardness": "hard", "on_entity": "lagging"},
    {"id": "yield_sane",  "description": "|yield| < 50% sanity bound",  "kind": "bound", "hardness": "soft", "on_entity": "term_struct"},
    {"id": "rate_nonneg", "description": "policy rate ≥ -1% (ZLB-aware)", "kind": "bound", "hardness": "soft", "on_entity": "policy_rate"}
  ],
  "seed_examples": [
    "leading indicator of recession",
    "regime shift in inflation expectations",
    "unusual labor market signal",
    "term structure inversion"
  ]
}
