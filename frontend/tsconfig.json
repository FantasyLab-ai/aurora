{
  "compilerOptions": {
    /* Target + module setup */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    /* Pull in Node type defs so vite.config.ts can use `node:path` +
       `node:url` + import.meta. Pulled from @types/node devDependency. */
    "types": ["node"],

    /* Pragmatic strictness — strict where it helps, lenient where the
       legacy DOM-mutation code interfaces. We'll tighten further once
       more of the codebase is migrated. */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Module resolution + interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Output (we don't actually emit — Vite handles bundling.) */
    "noEmit": true,
    "declaration": false,
    "sourceMap": true,

    /* Path aliases — must mirror vite.config.ts resolve.alias. */
    "baseUrl": ".",
    "paths": {
      "@/*":      ["src/*"],
      "@lib/*":   ["src/lib/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
