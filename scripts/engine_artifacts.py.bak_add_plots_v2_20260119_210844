from __future__ import annotations

import json
import os
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Optional, Tuple, List

import math

# Optional deps (we'll degrade gracefully if missing)
try:
    import pandas as pd
except Exception:  # pragma: no cover
    pd = None  # type: ignore

try:
    import numpy as np
except Exception:  # pragma: no cover
    np = None  # type: ignore

try:
    import matplotlib.pyplot as plt
except Exception:  # pragma: no cover
    plt = None  # type: ignore

try:
    import requests
except Exception:  # pragma: no cover
    requests = None  # type: ignore


def _extract_first_json_object(text: str):
    """
    Robustly extract the first valid JSON object from a messy LLM response.
    Returns (obj, err). If no obj, obj=None and err is a string.
    """
    if not isinstance(text, str) or not text.strip():
        return None, "empty_response"

    s = text.strip()

    # Fast path: exact JSON
    try:
        obj = json.loads(s)
        if isinstance(obj, dict):
            return obj, None
    except Exception:
        pass

    # Try to find the first balanced {...} region and parse it
    start = s.find("{")
    if start == -1:
        return None, "no_open_brace"

    # Balanced scan
    depth = 0
    in_str = False
    esc = False
    for i in range(start, len(s)):
        ch = s[i]
        if in_str:
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
            continue
        else:
            if ch == '"':
                in_str = True
                continue
            if ch == "{":
                depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    candidate = s[start:i+1]
                    try:
                        obj = json.loads(candidate)
                        if isinstance(obj, dict):
                            return obj, None
                    except Exception as e:
                        return None, f"json_parse_failed:{e}"

    return None, "no_balanced_object"

def _read_json(p: Path) -> Dict[str, Any]:
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        # last resort: return parse failure info
        return {"error": f"failed_to_parse_json:{p.name}"}


def _write_json(p: Path, obj: Any) -> None:
    p.write_text(json.dumps(obj, indent=2, ensure_ascii=False), encoding="utf-8")


def _now_iso() -> str:
    import datetime as _dt
    return _dt.datetime.now().isoformat(timespec="seconds")


def _safe_float(x: Any) -> Optional[float]:
    try:
        if x is None:
            return None
        f = float(x)
        if math.isnan(f) or math.isinf(f):
            return None
        return f
    except Exception:
        return None


def _exists_and_nonempty(p: Path) -> bool:
    try:
        return p.exists() and p.stat().st_size > 0
    except Exception:
        return False


@dataclass
class RunPaths:
    run_dir: Path
    deep_math: Path
    math_results: Path
    llm_narrative: Path
    llm_debug: Path
    storycard: Path
    tableselection: Path

    @staticmethod
    def from_run_dir(run_dir: Path) -> "RunPaths":
        return RunPaths(
            run_dir=run_dir,
            deep_math=run_dir / "deep_math.json",
            math_results=run_dir / "math_results.json",
            llm_narrative=run_dir / "llm_narrative.json",
            llm_debug=run_dir / "llm_debug.json",
            storycard=run_dir / "storycard.json",
            tableselection=run_dir / "tableselection.json",
        )


def build_run_meta(run_dir: Path, runner_stdout: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    # Small but useful metadata. We avoid hashing huge files to keep it fast.
    rp = RunPaths.from_run_dir(run_dir)
    meta = {
        "created_at": _now_iso(),
        "run_dir": str(run_dir),
        "env": {
            "AURORA_LLM_PROVIDER": os.getenv("AURORA_LLM_PROVIDER"),
            "OLLAMA_URL": os.getenv("OLLAMA_URL"),
            "OLLAMA_MODEL": os.getenv("OLLAMA_MODEL"),
        },
        "present_files": {
            "deep_math.json": _exists_and_nonempty(rp.deep_math),
            "math_results.json": _exists_and_nonempty(rp.math_results),
            "llm_narrative.json": _exists_and_nonempty(rp.llm_narrative),
            "llm_debug.json": _exists_and_nonempty(rp.llm_debug),
            "storycard.json": _exists_and_nonempty(rp.storycard),
            "tableselection.json": _exists_and_nonempty(rp.tableselection),
        },
    }
    if runner_stdout:
        meta["runner_stdout"] = runner_stdout
    return meta


def _enrich_engine_scorecard(out: Dict[str, Any], run_dir: Path, runtime_sec: Optional[float]) -> Dict[str, Any]:
    """
    Best-effort scorecard enrichment. Never raises.
    Reads already-generated artifacts and adds UI-friendly fields.
    Does NOT change any engine logic; it only formats outputs.
    """
    try:
        rp = RunPaths.from_run_dir(run_dir)

        deep = _read_json(rp.deep_math) if rp.deep_math.exists() else {}
        deep = deep or {}
        mathr = _read_json(rp.math_results) if rp.math_results.exists() else {}
        mathr = mathr or {}

        # Runtime (keep original if provided)
        if out.get("runtime_sec") is None and runtime_sec is not None:
            out["runtime_sec"] = runtime_sec

        # Rows / Cols
        rows = None
        cols = None
        if isinstance(deep, dict):
            rows = deep.get("rows") if rows is None else rows
            cols = deep.get("cols") if cols is None else cols
        if isinstance(mathr, dict):
            rows = mathr.get("rows") if rows is None else rows
            cols = mathr.get("cols") if cols is None else cols
        if rows is not None: out["rows"] = rows
        if cols is not None: out["cols"] = cols

        # Dataset label (best effort)
        # Prefer deep_math target/time cols if present
        dataset_bits = []
        if isinstance(deep, dict):
            tc = deep.get("time_col")
            yc = deep.get("target_col")
            if tc: dataset_bits.append(f"time_col={tc}")
            if yc: dataset_bits.append(f"target_col={yc}")
        # Fall back to run folder suffix (__raw, __aml, etc.)
        try:
            name = run_dir.name
            if "__" in name:
                dataset_bits.append("dataset=" + name.split("__", 1)[1])
        except Exception:
            pass
        if dataset_bits:
            out["dataset"] = ", ".join(dataset_bits)

        # Artifacts count (count known artifact files)
        try:
            # Count JSON + images + marker files in run_dir (shallow)
            n = 0
            for p in run_dir.iterdir():
                if p.is_file() and (p.suffix.lower() in [".json", ".png", ".jpg", ".jpeg", ".webp"] or p.name.startswith("_")):
                    n += 1
            out["artifacts_count"] = n
        except Exception:
            pass

        # Plots count / filenames
        try:
            plots_index = run_dir / "_PLOTS_INDEX.json"
            if plots_index.exists():
                pi = _read_json(plots_index) or {}
                files = pi.get("files") if isinstance(pi, dict) else None
                if isinstance(files, list):
                    out["plots_count"] = len(files)
                    out["plots_files"] = files
        except Exception:
            pass

        # Key findings (very light, derived from existing outputs)
        try:
            findings: Dict[str, Any] = {}

            if isinstance(mathr, dict):
                ta = mathr.get("top_anomalies")
                if isinstance(ta, list) and len(ta) > 0:
                    findings["top_anomalies"] = ta[:3]

                tc = mathr.get("top_correlations")
                if isinstance(tc, list) and len(tc) > 0:
                    findings["top_correlations"] = tc[:3]

                mt = mathr.get("missing_top")
                if isinstance(mt, list) and len(mt) > 0:
                    findings["top_missingness"] = mt[:3]

            if isinstance(deep, dict):
                # keep these as raw blobs; UI can render or stringify safely
                if "regimes" in deep: findings["regimes"] = deep.get("regimes")
                if "uncertainty" in deep: findings["uncertainty"] = deep.get("uncertainty")
                if "risk_surface" in deep: findings["risk_surface"] = deep.get("risk_surface")
                if "physics_consistency_score" in deep: findings["physics_consistency_score"] = deep.get("physics_consistency_score")

            if findings:
                out["key_findings"] = findings
        except Exception:
            pass

        return out
    except Exception:
        return out

def build_engine_scorecard(run_dir: Path, runtime_sec: Optional[float] = None) -> Dict[str, Any]:
    """
    Lightweight scorecard that the Studio UI can render.
    This must be robust to missing files.
    """
    rp = RunPaths.from_run_dir(run_dir)

    deep = _read_json(rp.deep_math) if rp.deep_math.exists() else {}
    deep = deep or {}
    mathr = _read_json(rp.math_results) if rp.math_results.exists() else {}
    mathr = mathr or {}

    def ok_section(obj: Any, key: str) -> bool:
        if not isinstance(obj, dict):
            return False
        v = obj.get(key)
        if not isinstance(v, dict):
            return False
        if v.get("note") == "ok":
            return True
        if v.get("ok") is True:
            return True
        return False

    engine_version = (
        deep.get("engine_version")
        or mathr.get("engine_version")
        or deep.get("version")
        or mathr.get("version")
        or "unknown"
    )

    scorecard = {
        "engine_version": engine_version,
        "runtime_sec": runtime_sec,
        "capabilities": {
            "math": bool(mathr) or ok_section(mathr, "math"),
            "math_v2": ok_section(mathr, "math_v2") or bool(mathr.get("math_v2")),
            "deep_math": bool(deep) or ok_section(deep, "deep_math"),
            "llm": _exists_and_nonempty(rp.llm_narrative),
        },
        "run_dir": str(run_dir),
    }
    return scorecard


def _try_generate_plots(run_dir: Path, plots_dir: Path) -> None:
    """
    Best-effort plot generator.
    Never raises (so your pipeline doesn't fail due to plotting).
    Uses the actual keys produced by your runner:
      deep_math.json: forecasting, regimes, uncertainty, ...
      math_results.json: top_anomalies, top_correlations, missing_top, ...
    Writes plots/_plot_debug.json to explain what was created/skipped.
    """
    try:
        plots_dir.mkdir(parents=True, exist_ok=True)

        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt

        rp = RunPaths.from_run_dir(run_dir)
        deep = _read_json(rp.deep_math) if rp.deep_math.exists() else {}
        deep = deep or {}
        mathr = _read_json(rp.math_results) if rp.math_results.exists() else {}
        mathr = mathr or {}

        def _dig(obj: Any, path: List[str]) -> Any:
            cur = obj
            for k in path:
                if not isinstance(cur, dict):
                    return None
                cur = cur.get(k)
            return cur

        def _first_list(*cands: Any) -> Optional[List[Any]]:
            for c in cands:
                if isinstance(c, list) and len(c) >= 2:
                    return c
            return None

        debug: Dict[str, Any] = {
            "run_dir": str(run_dir),
            "plots_dir": str(plots_dir),
            "deep_math_keys": sorted(list(deep.keys())) if isinstance(deep, dict) else None,
            "math_results_keys": sorted(list(mathr.keys())) if isinstance(mathr, dict) else None,
            "saved": [],
            "skipped": [],
        }

        # ----------------------------
        # 1) Forecast (forecast.png)
        # ----------------------------
        try:
            fc = None
            if isinstance(deep, dict):
                fc = deep.get("forecasting") or deep.get("forecast") or _dig(deep, ["results", "forecasting"])

            point = lower = upper = None

            if isinstance(fc, dict):
                # Try common names inside forecasting payload
                point = _first_list(
                    fc.get("point"), fc.get("mean"), fc.get("p50"), fc.get("yhat"), fc.get("forecast")
                )
                lower = _first_list(fc.get("lower"), fc.get("p10"), fc.get("lo"), fc.get("lower_ci"))
                upper = _first_list(fc.get("upper"), fc.get("p90"), fc.get("hi"), fc.get("upper_ci"))

                # Nested variants (super common)
                if point is None and isinstance(fc.get("series"), dict):
                    s = fc["series"]
                    point = _first_list(s.get("point"), s.get("mean"), s.get("p50"), s.get("yhat"), s.get("forecast"))
                    lower = _first_list(s.get("lower"), s.get("p10"), s.get("lo"), s.get("lower_ci"))
                    upper = _first_list(s.get("upper"), s.get("p90"), s.get("hi"), s.get("upper_ci"))

                if point is None and isinstance(fc.get("forecast"), dict):
                    s = fc["forecast"]
                    point = _first_list(s.get("point"), s.get("mean"), s.get("p50"), s.get("yhat"), s.get("values"))
                    lower = _first_list(s.get("lower"), s.get("p10"))
                    upper = _first_list(s.get("upper"), s.get("p90"))

            if isinstance(point, list) and len(point) >= 2:
                x = list(range(1, len(point) + 1))
                plt.figure()
                plt.plot(x, point, marker="o")
                if isinstance(lower, list) and isinstance(upper, list) and len(lower) == len(point) and len(upper) == len(point):
                    plt.fill_between(x, lower, upper, alpha=0.2)
                plt.title("Forecast")
                plt.xlabel("Horizon step")
                plt.ylabel("Value")
                plt.tight_layout()
                plt.savefig(str(plots_dir / "forecast.png"), dpi=160)
                plt.close()
                debug["saved"].append("forecast.png")
            else:
                debug["skipped"].append({"forecast.png": "no_series_found_in_deep_math.forecasting"})
        except Exception as e:
            try: plt.close("all")
            except Exception: pass
            debug["skipped"].append({"forecast.png": f"exception:{type(e).__name__}:{e}"})

        # -----------------------------------------
        # 2) Top anomalies (anomalies.png) - bar plot
        # -----------------------------------------
        try:
            ta = mathr.get("top_anomalies") if isinstance(mathr, dict) else None
            # Expected: list[dict] with score-like fields
            if isinstance(ta, list) and len(ta) >= 1 and isinstance(ta[0], dict):
                rows = ta[:20]
                scores = []
                labels = []
                for i, r in enumerate(rows):
                    sc = r.get("score") or r.get("anomaly_score") or r.get("z") or r.get("value")
                    scores.append(float(sc) if sc is not None else 0.0)
                    # prefer timestamp/index/row id if present
                    lab = r.get("t") or r.get("time") or r.get("timestamp") or r.get("idx") or r.get("row") or str(i)
                    labels.append(str(lab))

                plt.figure()
                plt.bar(range(len(scores)), scores)
                plt.title("Top anomalies")
                plt.xlabel("observation")
                plt.ylabel("score")
                if len(labels) <= 25:
                    plt.xticks(range(len(labels)), labels, rotation=60, ha="right", fontsize=7)
                plt.tight_layout()
                plt.savefig(str(plots_dir / "anomalies.png"), dpi=160)
                plt.close()
                debug["saved"].append("anomalies.png")
            else:
                debug["skipped"].append({"anomalies.png": "math_results.top_anomalies missing or not list[dict]"})
        except Exception as e:
            try: plt.close("all")
            except Exception: pass
            debug["skipped"].append({"anomalies.png": f"exception:{type(e).__name__}:{e}"})

        # ------------------------------------------------
        # 3) Top correlations (correlations.png) - bar plot
        # ------------------------------------------------
        try:
            tc = mathr.get("top_correlations") if isinstance(mathr, dict) else None
            # Expected: list[dict] with col pairs + corr
            if isinstance(tc, list) and len(tc) >= 1 and isinstance(tc[0], dict):
                rows = tc[:20]
                vals = []
                labels = []
                for r in rows:
                    v = r.get("corr") or r.get("value") or r.get("r")
                    vals.append(float(v) if v is not None else 0.0)
                    a = r.get("a") or r.get("col_a") or r.get("x") or r.get("col1") or r.get("c1")
                    b = r.get("b") or r.get("col_b") or r.get("y") or r.get("col2") or r.get("c2")
                    if a is not None and b is not None:
                        labels.append(f"{a} vs {b}")
                    else:
                        labels.append(str(r.get("pair") or r.get("name") or "pair"))

                plt.figure()
                plt.barh(range(len(vals)), vals)
                plt.title("Top correlations")
                plt.xlabel("correlation")
                plt.yticks(range(len(labels)), labels, fontsize=7)
                plt.tight_layout()
                plt.savefig(str(plots_dir / "correlations.png"), dpi=160)
                plt.close()
                debug["saved"].append("correlations.png")
            else:
                debug["skipped"].append({"correlations.png": "math_results.top_correlations missing or not list[dict]"})
        except Exception as e:
            try: plt.close("all")
            except Exception: pass
            debug["skipped"].append({"correlations.png": f"exception:{type(e).__name__}:{e}"})

        # -----------------------------------------
        # 4) Missingness (missingness.png) - bar plot
        # -----------------------------------------
        try:
            mt = mathr.get("missing_top") if isinstance(mathr, dict) else None
            # Expected: list[dict] with column + missing %
            if isinstance(mt, list) and len(mt) >= 1 and isinstance(mt[0], dict):
                rows = mt[:20]
                cols = []
                pct = []
                for r in rows:
                    c = r.get("col") or r.get("column") or r.get("name")
                    cols.append(str(c))
                    p = r.get("pct") or r.get("pct_missing") or r.get("missing_pct") or r.get("share")
                    pct.append(float(p) if p is not None else 0.0)

                plt.figure()
                plt.barh(range(len(pct)), pct)
                plt.title("Top missingness")
                plt.xlabel("percent missing")
                plt.yticks(range(len(cols)), cols, fontsize=7)
                plt.tight_layout()
                plt.savefig(str(plots_dir / "missingness.png"), dpi=160)
                plt.close()
                debug["saved"].append("missingness.png")
            else:
                debug["skipped"].append({"missingness.png": "math_results.missing_top missing or not list[dict]"})
        except Exception as e:
            try: plt.close("all")
            except Exception: pass
            debug["skipped"].append({"missingness.png": f"exception:{type(e).__name__}:{e}"})

        # Write debug log (never fail)
        try:
            _write_json(plots_dir / "_plot_debug.json", debug)
        except Exception:
            pass

    except Exception:
        # absolutely never crash artifact generation due to plots
        return

def _build_plots_index(run_dir: Path, plots_dir: Path, plot_files: List[str]) -> Dict[str, Any]:
    """
    Backwards compatible plots index writer.
    Always includes legacy PNG files.
    If Plot Pack v2 JSON payloads exist under run_dir/plots_data, includes plots_v2 entries too.
    Never raises.
    """
    # Start from existing index if present (preserve any extra fields)
    existing: Dict[str, Any] = {}
    try:
        existing = _read_json(run_dir / "_PLOTS_INDEX.json") or {}
        if not isinstance(existing, dict):
            existing = {}
    except Exception:
        existing = {}

    out: Dict[str, Any] = dict(existing)

    # Legacy PNG behavior (do not change)
    out["plots_dir"] = str(plots_dir)
    out["files"] = list(plot_files)

    # Plot Pack v2 discovery (domain-agnostic)
    plots_data_dir = run_dir / "plots_data"
    if plots_data_dir.exists():
        try:
            json_files = sorted([p.name for p in plots_data_dir.iterdir() if p.is_file() and p.suffix.lower() == ".json"])
        except Exception:
            json_files = []

        # Known payloads -> kinds the UI can render
        kind_map = {
            "summary_cards.json": ("cards", "Summary"),
            "forecast_ci.json": ("line_ci", "Forecast (CI)"),
            "risk_surface_bands.json": ("bands", "Risk surface (bands)"),
            "correlation_pairs_ci.json": ("pairs_ci", "Top correlations (CI)"),
            "regimes.json": ("regimes", "Regimes / drift"),
        }

        plots_v2: List[Dict[str, Any]] = []
        for jf in json_files:
            kind, title = kind_map.get(
                jf,
                ("json", jf.replace(".json", "").replace("_", " ").title()),
            )
            plots_v2.append(
                {
                    "id": jf.replace(".json", ""),
                    "title": title,
                    "kind": kind,
                    "data_file": f"plots_data/{jf}",
                    "thumb_file": None,
                }
            )

        out["plot_pack_version"] = "v2"
        out["plots_data_dir"] = "plots_data"
        out["plots_v2"] = plots_v2

    return out

def generate_all_artifacts(run_dir: Path, runner_stdout: Optional[Dict[str, Any]] = None, runtime_sec: Optional[float] = None, do_plots: bool = True, **kwargs) -> Dict[str, Any]:
    """
    Entry-point expected by scripts.run_aurora_with_steps_1_4.
    Writes minimal artifacts the Studio UI consumes.
    """
    t0 = time.time()

    run_dir = Path(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)

    # Meta + scorecard
    run_meta = build_run_meta(run_dir, runner_stdout=runner_stdout)
    _write_json(run_dir / "_RUN_META.json", run_meta)

    scorecard = build_engine_scorecard(run_dir, runtime_sec=runtime_sec)
    _write_json(run_dir / "_ENGINE_SCORECARD.json", scorecard)

    # Optional: plots index if you have a plots/ folder
    plots_dir = run_dir / "plots"
    if do_plots:
        _try_generate_plots(run_dir, plots_dir)
    plot_files: List[str] = []
    if plots_dir.exists():
        for p in plots_dir.iterdir():
            if p.is_file() and p.suffix.lower() in [".png", ".jpg", ".jpeg", ".webp"]:
                plot_files.append(p.name)
    plot_files.sort()
    plots_info = _build_plots_index(run_dir, plots_dir, plot_files)
    _write_json(run_dir / "_PLOTS_INDEX.json", plots_info)
    out = {
        "run_dir": str(run_dir),
        "meta": str(run_dir / "_RUN_META.json"),
        "scorecard": str(run_dir / "_ENGINE_SCORECARD.json"),
        "plots_index": str(run_dir / "_PLOTS_INDEX.json"),
        "artifacts_runtime_sec": round(time.time() - t0, 4),
    }
    _write_json(run_dir / "_ARTIFACTS_DONE.json", out)
    out = _enrich_engine_scorecard(out, run_dir, runtime_sec)
    return out


