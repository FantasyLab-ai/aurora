from __future__ import annotations

import json
import os
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Optional, Tuple, List

import math

# Optional deps (we'll degrade gracefully if missing)
try:
    import pandas as pd
except Exception:  # pragma: no cover
    pd = None  # type: ignore

try:
    import numpy as np
except Exception:  # pragma: no cover
    np = None  # type: ignore

try:
    import matplotlib.pyplot as plt
except Exception:  # pragma: no cover
    plt = None  # type: ignore

try:
    import requests
except Exception:  # pragma: no cover
    requests = None  # type: ignore


def _read_json(p: Path) -> Dict[str, Any]:
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        # last resort: return parse failure info
        return {"error": f"failed_to_parse_json:{p.name}"}


def _write_json(p: Path, obj: Any) -> None:
    p.write_text(json.dumps(obj, indent=2, ensure_ascii=False), encoding="utf-8")


def _now_iso() -> str:
    import datetime as _dt
    return _dt.datetime.now().isoformat(timespec="seconds")


def _safe_float(x: Any) -> Optional[float]:
    try:
        if x is None:
            return None
        f = float(x)
        if math.isnan(f) or math.isinf(f):
            return None
        return f
    except Exception:
        return None


def _exists_and_nonempty(p: Path) -> bool:
    try:
        return p.exists() and p.stat().st_size > 0
    except Exception:
        return False


@dataclass
class RunPaths:
    run_dir: Path
    deep_math: Path
    math_results: Path
    llm_narrative: Path
    llm_debug: Path
    storycard: Path
    tableselection: Path

    @staticmethod
    def from_run_dir(run_dir: Path) -> "RunPaths":
        return RunPaths(
            run_dir=run_dir,
            deep_math=run_dir / "deep_math.json",
            math_results=run_dir / "math_results.json",
            llm_narrative=run_dir / "llm_narrative.json",
            llm_debug=run_dir / "llm_debug.json",
            storycard=run_dir / "storycard.json",
            tableselection=run_dir / "tableselection.json",
        )


def build_run_meta(run_dir: Path, runner_stdout: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    # Small but useful metadata. We avoid hashing huge files to keep it fast.
    rp = RunPaths.from_run_dir(run_dir)
    meta = {
        "created_at": _now_iso(),
        "run_dir": str(run_dir),
        "env": {
            "AURORA_LLM_PROVIDER": os.getenv("AURORA_LLM_PROVIDER"),
            "OLLAMA_URL": os.getenv("OLLAMA_URL"),
            "OLLAMA_MODEL": os.getenv("OLLAMA_MODEL"),
        },
        "present_files": {
            "deep_math.json": _exists_and_nonempty(rp.deep_math),
            "math_results.json": _exists_and_nonempty(rp.math_results),
            "llm_narrative.json": _exists_and_nonempty(rp.llm_narrative),
            "llm_debug.json": _exists_and_nonempty(rp.llm_debug),
            "storycard.json": _exists_and_nonempty(rp.storycard),
            "tableselection.json": _exists_and_nonempty(rp.tableselection),
        },
    }
    if runner_stdout:
        meta["runner_stdout"] = runner_stdout
    return meta


def build_engine_scorecard(run_dir: Path, runtime_sec: Optional[float] = None) -> Dict[str, Any]:
    rp = RunPaths.from_run_dir(run_dir)
    deep = _read_json(rp.deep_math)
    mathr = _read_json(rp.math_results)

    # Detect "successful" execution of each capability
    def ok_section(obj: Dict[str, Any], key: str) -> bool:
        v = obj.get(key)
        if isinstance(v, dict) and "error" in v:
            return False
        return v is not None and v != {}

    capabilities = {
        "data_validation": True if mathr and "error" not in mathr else False,
        "statistical_summary": True if mathr and "top_correlations" in mathr else False,
        "anomaly_detection": True if mathr and "top_anomalies" in mathr else False,
        "regime_detection": ok_section(deep, "regimes") and isinstance(deep.get("regimes"), dict) and deep["regimes"].get("note") == "ok",
        "forecasting": ok_section(deep, "forecasting") and isinstance(deep.get("forecasting"), dict) and deep["forecasting"].get("note") == "ok",
        "uncertainty_quantification": ok_section(deep, "uncertainty"),
        "risk_surface": ok_section(deep, "risk_surface"),
        "causal_inference": ok_section(deep, "causal_what_if") and isinstance(deep.get("causal_what_if"), dict) and deep["causal_what_if"].get("note") == "ok",
        "optimization": ok_section(deep, "optimization_demo"),
    }

    # Key findings (best-effort)
    rows = deep.get("rows") or mathr.get("rows")
    cols = deep.get("cols") or mathr.get("cols")
    strongest = None
    try:
        tc = mathr.get("top_correlations") or []
        if isinstance(tc, list) and tc:
            strongest = tc[0]
    except Exception:
        pass

    dominant_regimes = None
    try:
        if isinstance(deep.get("regimes"), dict):
            dominant_regimes = deep["regimes"].get("regime_count")
    except Exception:
        pass

    largest_anom = None
    try:
        ta = mathr.get("top_anomalies") or []
        if isinstance(ta, list) and ta:
            largest_anom = ta[0].get("score")
    except Exception:
        pass

    # A simple "engine confidence" heuristic (not scientific, but useful as a health score)
    executed = sum(1 for v in capabilities.values() if v)
    total = len(capabilities)
    engine_conf = round(executed / max(1, total), 4)

    scorecard = {
        "engine_version": deep.get("version") or "unknown",
        "dataset": (deep.get("dataset_key") or deep.get("dataset") or None),
        "rows": rows,
        "cols": cols,
        "runtime_sec": runtime_sec,
        "capabilities_executed": capabilities,
        "health_checks": {
            "deep_math_json_ok": bool(deep) and "error" not in deep,
            "math_results_json_ok": bool(mathr) and "error" not in mathr,
            "model_failures": int(total - executed),
        },
        "key_findings": {
            "target_col": deep.get("target_col"),
            "time_col": deep.get("time_col"),
            "strongest_relationship": strongest,
            "dominant_regimes": dominant_regimes,
            "largest_anomaly_score": largest_anom,
        },
        "risk_outlook": {
            "uncertainty_model": (deep.get("risk_surface") or {}).get("method") if isinstance(deep.get("risk_surface"), dict) else None,
            "forecast_horizon": (deep.get("risk_surface") or {}).get("horizon") if isinstance(deep.get("risk_surface"), dict) else None,
        },
        "causal_summary": deep.get("causal_what_if") if isinstance(deep.get("causal_what_if"), dict) else None,
        "engine_confidence": engine_conf,
        "generated_at": _now_iso(),
    }

    # Attach dataset_key if runner stored it anywhere else
    # (We keep it flexible; your pipeline evolves)
    if scorecard["dataset"] is None:
        # often present in run_dir naming; last token after "__"
        name = run_dir.name
        if "__" in name:
            scorecard["dataset"] = name.split("__", 1)[1]

    return scorecard


def _ensure_plots_dir(run_dir: Path) -> Path:
    p = run_dir / "plots"
    p.mkdir(parents=True, exist_ok=True)
    return p


def _plot_save(fig, out: Path) -> None:
    fig.tight_layout()
    fig.savefig(out, dpi=150)
    plt.close(fig)


def generate_plots(run_dir: Path) -> Dict[str, Any]:
    """
    Produces basic credibility plots:
      - missingness bar
      - top correlations bar
      - anomaly score distribution (if present)
      - regimes change points plot (if present)
      - forecast fan chart (if present)
    """
    if pd is None or plt is None:
        return {"error": "plotting_unavailable: install pandas + matplotlib"}

    rp = RunPaths.from_run_dir(run_dir)
    plots_dir = _ensure_plots_dir(run_dir)

    deep = _read_json(rp.deep_math)
    mathr = _read_json(rp.math_results)

    out_index: Dict[str, Any] = {"plots_dir": str(plots_dir), "files": []}

    # --- Missingness bar (from math_results missing_top) ---
    try:
        miss = mathr.get("missing_top")
        if isinstance(miss, list) and len(miss) > 0:
            cols = [m.get("col") for m in miss][:15]
            pct = [m.get("pct_missing") for m in miss][:15]
            fig = plt.figure()
            ax = fig.add_subplot(111)
            ax.bar(range(len(cols)), pct)
            ax.set_xticks(range(len(cols)))
            ax.set_xticklabels(cols, rotation=60, ha="right")
            ax.set_ylabel("pct_missing")
            ax.set_title("Top Missingness")
            outp = plots_dir / "missingness.png"
            _plot_save(fig, outp)
            out_index["files"].append(outp.name)
    except Exception as e:
        out_index["missingness_error"] = str(e)

    # --- Top correlations bar ---
    try:
        tc = mathr.get("top_correlations")
        if isinstance(tc, list) and len(tc) > 0:
            labels = [f"{x.get('a')}↔{x.get('b')}" for x in tc[:12]]
            vals = [x.get("corr") for x in tc[:12]]
            fig = plt.figure()
            ax = fig.add_subplot(111)
            ax.bar(range(len(labels)), vals)
            ax.set_xticks(range(len(labels)))
            ax.set_xticklabels(labels, rotation=60, ha="right")
            ax.set_ylabel("corr")
            ax.set_title("Top Correlations")
            outp = plots_dir / "correlations.png"
            _plot_save(fig, outp)
            out_index["files"].append(outp.name)
    except Exception as e:
        out_index["correlations_error"] = str(e)

    # --- Anomaly score distribution ---
    try:
        ta = mathr.get("top_anomalies")
        if isinstance(ta, list) and len(ta) > 0:
            scores = [x.get("score") for x in ta if _safe_float(x.get("score")) is not None]
            if len(scores) > 0:
                fig = plt.figure()
                ax = fig.add_subplot(111)
                ax.hist(scores, bins=min(25, max(5, len(scores))))
                ax.set_xlabel("anomaly_score")
                ax.set_ylabel("count")
                ax.set_title("Top Anomaly Score Distribution")
                outp = plots_dir / "anomalies.png"
                _plot_save(fig, outp)
                out_index["files"].append(outp.name)
    except Exception as e:
        out_index["anomalies_error"] = str(e)

    # --- Regime change points plot ---
    try:
        reg = deep.get("regimes")
        if isinstance(reg, dict) and reg.get("note") == "ok":
            cps = reg.get("change_points") or []
            n = reg.get("n")
            if isinstance(cps, list) and n:
                fig = plt.figure()
                ax = fig.add_subplot(111)
                ax.set_title("Regime Change Points")
                ax.set_xlabel("index")
                ax.set_yticks([])
                ax.set_ylim(0, 1)
                # baseline
                ax.hlines(0.5, 0, n, linewidth=2)
                for cp in cps:
                    try:
                        ax.vlines(int(cp), 0.25, 0.75)
                    except Exception:
                        pass
                outp = plots_dir / "regimes.png"
                _plot_save(fig, outp)
                out_index["files"].append(outp.name)
    except Exception as e:
        out_index["regimes_error"] = str(e)

    # --- Forecast fan chart (if present) ---
    try:
        rs = deep.get("risk_surface")
        if isinstance(rs, dict) and rs.get("method") and isinstance(rs.get("bands"), dict):
            bands = rs["bands"]
            p05 = bands.get("p05")
            p50 = bands.get("p50")
            p95 = bands.get("p95")
            if isinstance(p05, list) and isinstance(p50, list) and isinstance(p95, list):
                x = list(range(1, len(p50) + 1))
                fig = plt.figure()
                ax = fig.add_subplot(111)
                ax.plot(x, p50, label="p50")
                ax.fill_between(x, p05, p95, alpha=0.2)
                ax.set_title("Forecast Risk Bands (p05–p95)")
                ax.set_xlabel("horizon_step")
                ax.set_ylabel("value")
                outp = plots_dir / "forecast.png"
                _plot_save(fig, outp)
                out_index["files"].append(outp.name)
    except Exception as e:
        out_index["forecast_error"] = str(e)

    return out_index


def _ollama_generate(prompt: str, timeout: int = 60) -> Tuple[bool, str]:
    """
    Uses Ollama /api/generate (simple & robust).
    """
    if requests is None:
        return False, "requests_not_installed"

    url = os.getenv("OLLAMA_URL", "http://127.0.0.1:11434").rstrip("/")
    model = os.getenv("OLLAMA_MODEL", "deepseek-r1:8b")
    endpoint = f"{url}/api/generate"
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {"temperature": 0.2},
    }
    try:
        r = requests.post(endpoint, json=payload, timeout=timeout)
        r.raise_for_status()
        data = r.json()
        txt = data.get("response", "")
        return True, txt
    except Exception as e:
        return False, f"ollama_error:{e}"


def build_guardrailed_llm_prompt(scorecard: Dict[str, Any], deep_math: Dict[str, Any]) -> str:
    """
    Strongly forces JSON-only output and blocks free-form narration.
    """
    schema = {
        "executive_summary": "string",
        "scientific_summary": "string",
        "limitations": ["string"],
        "recommended_next_steps": ["string"],
        "evidence": {
            "capabilities_executed": "object",
            "key_findings": "object",
            "failures": ["string"],
        },
    }

    return (
        "SYSTEM: You are a strict JSON generator. Output ONLY valid JSON. No markdown. No commentary.\n"
        "SYSTEM: If you cannot comply, output this exact JSON: {\"error\":\"noncompliant\"}\n"
        "TASK: Summarize results strictly grounded in the provided JSON. Do not invent any facts.\n"
        "RULES:\n"
        " - Use only values present in SCORECARD_JSON and DEEP_MATH_JSON.\n"
        " - If a section has 'error', list it under evidence.failures and mention it in limitations.\n"
        " - Keep executive_summary <= 1200 chars.\n"
        " - Keep scientific_summary <= 2500 chars.\n"
        f"OUTPUT_SCHEMA={json.dumps(schema, ensure_ascii=False)}\n"
        f"SCORECARD_JSON={json.dumps(scorecard, ensure_ascii=False)}\n"
        f"DEEP_MATH_JSON={json.dumps(deep_math, ensure_ascii=False)}\n"
        "OUTPUT: "
    )


def generate_guarded_llm_summary(run_dir: Path, scorecard: Dict[str, Any]) -> Dict[str, Any]:
    """
    Writes llm_narrative_guarded.json (does NOT overwrite your existing llm_narrative.json).
    """
    rp = RunPaths.from_run_dir(run_dir)
    deep = _read_json(rp.deep_math)

    prompt = build_guardrailed_llm_prompt(scorecard, deep)
    ok, txt = _ollama_generate(prompt, timeout=90)
    out = {
        "ok": ok,
        "model": os.getenv("OLLAMA_MODEL"),
        "provider": os.getenv("AURORA_LLM_PROVIDER"),
        "generated_at": _now_iso(),
        "raw_response": txt,
    }

    # Best effort: parse JSON response
    if ok:
        try:
            # Some models wrap JSON in text; try to locate first/last braces
            s = txt
            a = s.find("{")
            b = s.rfind("}")
            if a != -1 and b != -1 and b > a:
                obj = json.loads(s[a : b + 1])
                out["parsed"] = obj
            else:
                out["parsed_error"] = "no_json_object_detected"
        except Exception as e:
            out["parsed_error"] = str(e)

    _write_json(run_dir / "llm_narrative_guarded.json", out)
    return out


def generate_all_artifacts(
    run_dir: Path,
    runner_stdout: Optional[Dict[str, Any]] = None,
    do_plots: bool = True,
    do_guarded_llm: bool = True,
) -> Dict[str, Any]:
    """
    Step 1: _RUN_META.json
    Step 2: _ENGINE_SCORECARD.json
    Step 3: plots/
    Step 4: llm_narrative_guarded.json (optional)
    """
    t0 = time.time()

    run_dir = Path(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)

    meta = build_run_meta(run_dir, runner_stdout=runner_stdout)
    _write_json(run_dir / "_RUN_META.json", meta)

    # Scorecard: built before plots so the LLM can reference it
    scorecard = build_engine_scorecard(run_dir, runtime_sec=None)
    _write_json(run_dir / "_ENGINE_SCORECARD.json", scorecard)

    plots_info = None
    if do_plots:
        plots_info = generate_plots(run_dir)
        _write_json(run_dir / "_PLOTS_INDEX.json", plots_info)

    llm_info = None
    if do_guarded_llm:
        # Only try if user configured Ollama
        if os.getenv("AURORA_LLM_PROVIDER") == "ollama":
            llm_info = generate_guarded_llm_summary(run_dir, scorecard)
        else:
            llm_info = {"skipped": True, "reason": "AURORA_LLM_PROVIDER != ollama"}
        _write_json(run_dir / "_LLM_GUARDED_INDEX.json", llm_info)

    t1 = time.time()
    out = {
        "run_dir": str(run_dir),
        "meta": str(run_dir / "_RUN_META.json"),
        "scorecard": str(run_dir / "_ENGINE_SCORECARD.json"),
        "plots": plots_info,
        "llm_guarded": llm_info,
        "artifacts_runtime_sec": round(t1 - t0, 4),
    }
    _write_json(run_dir / "_ARTIFACTS_DONE.json", out)
    return out
