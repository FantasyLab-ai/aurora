def _load_dataset(csv_path: Path) -> pd.DataFrame:
    # Accept either a CSV file or a folder containing CSVs
    p = csv_path
    if p.exists() and p.is_dir():
        picked = _pick_latest_csv(p)
        if picked is None:
            raise FileNotFoundError(f"No .csv found in folder: {p}")
        p = picked

    if not p.exists():
        raise FileNotFoundError(f"Dataset path does not exist: {p}")

    df = pd.read_csv(p)
    return df
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional

from .engine_artifacts import generate_all_artifacts


def _extract_last_json(stdout_text: str) -> Optional[Dict[str, Any]]:
    """
    Your runner prints a final JSON blob. We grab the last {...} block.
    """
    s = stdout_text.strip()
    if not s:
        return None
    a = s.rfind("{")
    b = s.rfind("}")
    if a == -1 or b == -1 or b <= a:
        return None
    try:
        return json.loads(s[a : b + 1])
    except Exception:
        return None


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)

    # Run the canonical runner as a subprocess to avoid importing its internals (keeps this stable)
    cmd = [sys.executable, "-m", "scripts.run_aurora_dataset_runner"] + argv
    proc = subprocess.run(cmd, capture_output=True, text=True)

    # Always forward output so your normal UX remains
    if proc.stdout:
        print(proc.stdout, end="")
    if proc.stderr:
        print(proc.stderr, end="", file=sys.stderr)

    if proc.returncode != 0:
        return proc.returncode

    runner_json = _extract_last_json(proc.stdout or "")
    if not runner_json or "run_dir" not in runner_json:
        print("[WARN] Could not detect run_dir from runner stdout JSON. No artifacts generated.", file=sys.stderr)
        return 0

    run_dir = Path(runner_json["run_dir"])
    out = generate_all_artifacts(
        run_dir=run_dir,
        runner_stdout=runner_json,
        do_plots=True,
        do_guarded_llm=True,
    )

    print("\n[ARTIFACTS] wrote:")
    print(json.dumps(out, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

