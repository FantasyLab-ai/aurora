from __future__ import annotations

import json
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# -----------------------------
# Helpers
# -----------------------------
def _read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def _resolve_run_dir(run_dir: str) -> Path:
    p = Path(run_dir).expanduser().resolve()
    if p.is_dir():
        return p
    raise FileNotFoundError(f"Run dir not found: {p}")


def _get_dataset_path(run_meta: dict) -> Optional[str]:
    # Best-effort; keep flexible with prior meta formats
    for key in ("dataset_path", "dataset", "csv_path", "table"):
        v = run_meta.get(key)
        if isinstance(v, str) and v:
            return v
    # Some metas store inside nested config
    cfg = run_meta.get("config")
    if isinstance(cfg, dict):
        for key in ("dataset_path", "dataset", "csv_path", "table"):
            v = cfg.get(key)
            if isinstance(v, str) and v:
                return v
    return None


def _load_dataset(csv_path: str, time_col: Optional[str] = None) -> pd.DataFrame:
    df = pd.read_csv(csv_path)
    if time_col and time_col in df.columns:
        try:
            df[time_col] = pd.to_datetime(df[time_col], errors="coerce")
            df = df.sort_values(time_col)
        except Exception:
            pass
    return df


def _plots_dir(run_dir: Path) -> Path:
    p = run_dir / "plots"
    p.mkdir(parents=True, exist_ok=True)
    return p


def _shorten(s: str, max_len: int = 36) -> str:
    s = str(s)
    if len(s) <= max_len:
        return s
    return s[: max_len - 1] + "…"


def _set_dark_theme():
    # Global defaults (kept subtle, readable)
    plt.rcParams.update({
        "figure.facecolor": "#0B0F19",
        "axes.facecolor":   "#0B0F19",
        "savefig.facecolor":"#0B0F19",
        "text.color":       "#E6EAF2",
        "axes.labelcolor":  "#E6EAF2",
        "axes.edgecolor":   "#374151",
        "xtick.color":      "#C7CEDB",
        "ytick.color":      "#C7CEDB",
        "grid.color":       "#263041",
        "grid.alpha":       0.35,
        "font.size":        12,
    })


def _style_ax(ax, title: str, subtitle: Optional[str] = None):
    ax.set_title(title, fontsize=16, fontweight="bold", pad=10)
    if subtitle:
        ax.text(
            0.0, 1.02, subtitle,
            transform=ax.transAxes,
            ha="left", va="bottom",
            fontsize=11, color="#C7CEDB"
        )
    ax.grid(True, axis="both", linestyle="-", linewidth=0.8)
    for spine in ax.spines.values():
        spine.set_alpha(0.6)
    ax.tick_params(labelsize=11)


def _badge(ax, text: str):
    ax.text(
        0.01, 0.98, text,
        transform=ax.transAxes,
        ha="left", va="top",
        fontsize=11,
        bbox=dict(boxstyle="round,pad=0.55", facecolor="#111827", edgecolor="#334155", alpha=0.85),
        color="#E6EAF2",
    )


def _save(fig, path: Path):
    fig.tight_layout()
    fig.savefig(path, dpi=180, bbox_inches="tight")
    plt.close(fig)


# -----------------------------
# Plot builders
# -----------------------------
def build_forecast_insight(run_dir: Path, df: pd.DataFrame, deep_math: dict):
    plots_dir = _plots_dir(run_dir)

    # Prefer the model’s named target if available
    target = deep_math.get("target_col") or deep_math.get("target") or deep_math.get("y_col")
    time_col = deep_math.get("time_col")

    # Pull forecast arrays if present
    forecast = None
    if isinstance(deep_math, dict):
        forecast = deep_math.get("forecast")

    point = None
    lower = None
    upper = None
    horizon = None

    if isinstance(forecast, dict):
        point = forecast.get("point") or forecast.get("mean")
        lower = forecast.get("lower")
        upper = forecast.get("upper")
        horizon = forecast.get("horizon")

    # Fallback: if not present, do something minimal (won’t crash)
    if not isinstance(point, list):
        point = []
    if not isinstance(lower, list):
        lower = []
    if not isinstance(upper, list):
        upper = []
    if not isinstance(horizon, int):
        horizon = len(point) if point else 24

    # Pick a reasonable series from the dataframe
    y = None
    if isinstance(target, str) and target in df.columns:
        y = df[target].astype(float).replace([np.inf, -np.inf], np.nan).dropna()
        target_name = target
    else:
        # choose first numeric column
        num_cols = df.select_dtypes(include=[np.number]).columns.tolist()
        target_name = num_cols[0] if num_cols else "value"
        y = df[target_name].astype(float).replace([np.inf, -np.inf], np.nan).dropna() if target_name in df.columns else pd.Series(dtype=float)

    hist = y.tail(240) if len(y) > 0 else pd.Series(dtype=float)

    _set_dark_theme()
    fig, ax = plt.subplots(figsize=(10.8, 4.8))
    title = f"Forecast • {target_name} • horizon={horizon}"
    subtitle = "Historical context + forward signal + uncertainty band"

    if len(hist) > 0:
        ax.plot(np.arange(len(hist)) * -1, hist.values, linewidth=1.4, alpha=0.9)
        ax.axhline(float(hist.mean()), linewidth=1.0, alpha=0.6)
        ax.text(0.01, 0.05, f"Mean threshold (last window): {hist.mean():.2f}", transform=ax.transAxes, fontsize=10, color="#C7CEDB")

    if point:
        x0 = 0
        x = np.arange(x0, x0 + len(point))
        ax.plot(x, point, linewidth=2.4)
        if lower and upper and len(lower) == len(point) and len(upper) == len(point):
            ax.fill_between(x, lower, upper, alpha=0.25)

    _style_ax(ax, title, subtitle)
    ax.set_xlabel("Horizon step (0 = now)")
    ax.set_ylabel(target_name)

    # badge stats
    if point:
        delta = float(point[-1]) - float(point[0])
        band = None
        if lower and upper and len(lower) == len(point) and len(upper) == len(point):
            band = (float(upper[-1]) - float(lower[-1])) / 2.0
        msg = f"Mean change to horizon: {delta:+.2f}"
        if band is not None:
            msg += f"\n95% band @ horizon: ±{band:.2f}"
        regimes = deep_math.get("regimes")
        if isinstance(regimes, list):
            msg += f"\nRegimes detected: {len(regimes)}"
        _badge(ax, msg)

    _save(fig, plots_dir / "forecast_insight.png")


def build_anomalies_insight(run_dir: Path, math_results: dict):
    plots_dir = _plots_dir(run_dir)
    an = math_results.get("anomalies") if isinstance(math_results, dict) else None
    if not isinstance(an, dict):
        return

    scores = an.get("scores")
    ids = an.get("ids") or an.get("indices") or an.get("rows")
    if not isinstance(scores, list) or not scores:
        return

    # Keep top N
    N = min(20, len(scores))
    arr = np.array(scores, dtype=float)
    order = np.argsort(-arr)[:N]
    top_scores = arr[order]
    if isinstance(ids, list) and len(ids) == len(scores):
        labels = [str(ids[i]) for i in order]
    else:
        labels = [str(int(i)) for i in order]

    labels_short = [_shorten(l, 16) for l in labels]

    _set_dark_theme()
    fig, ax = plt.subplots(figsize=(10.8, 4.8))
    ax.bar(np.arange(N), top_scores)
    _style_ax(ax, "Top anomalies • highest severity observations", "Ranked by anomaly score (tail risk)")

    ax.set_xlabel("Ranked anomaly")
    ax.set_ylabel("Score")
    ax.set_xticks(np.arange(N))
    ax.set_xticklabels(labels_short, rotation=0, fontsize=10)

    # annotate a few bars
    for i in range(min(6, N)):
        ax.text(i, top_scores[i], f"{top_scores[i]:.2f}", ha="center", va="bottom", fontsize=10, color="#E6EAF2")

    med = float(np.median(arr))
    p90 = float(np.percentile(arr, 90))
    flag = "YES" if float(top_scores[0]) > p90 else "no"
    _badge(ax, f"Median top-20 score: {np.median(top_scores):.2f}\n90th pct baseline: {p90:.2f}\nTail severity elevated: {flag}")

    _save(fig, plots_dir / "anomalies_insight.png")


def build_correlations_insight(run_dir: Path, math_results: dict):
    plots_dir = _plots_dir(run_dir)
    cor = math_results.get("correlations") if isinstance(math_results, dict) else None
    if not isinstance(cor, dict):
        return

    labels = cor.get("labels")
    vals = cor.get("values")
    if not isinstance(labels, list) or not isinstance(vals, list) or not labels or not vals:
        return

    vals = np.array(vals, dtype=float)
    pairs = [str(x) for x in labels]
    # sort by absolute correlation
    order = np.argsort(-np.abs(vals))[: min(12, len(vals))]
    vals = vals[order]
    pairs = [pairs[i] for i in order]
    pairs_short = [_shorten(p, 42) for p in pairs]

    _set_dark_theme()
    fig_h = max(4.8, 0.40 * len(vals) + 2.6)
    fig, ax = plt.subplots(figsize=(10.8, fig_h))

    y = np.arange(len(vals))
    ax.barh(y, vals)
    ax.axvline(0.0, linewidth=1.0, alpha=0.6)

    _style_ax(ax, "Top correlations • strongest relationships", "Highest |r| pairs (coupling, not causality)")
    ax.set_xlabel("Correlation (r)")
    ax.set_yticks(y)
    ax.set_yticklabels(pairs_short, fontsize=11)

    # symmetric xlim around 0 for readability
    mx = float(np.max(np.abs(vals))) if len(vals) else 1.0
    ax.set_xlim(-max(0.1, mx) * 1.15, max(0.1, mx) * 1.15)

    # annotate values
    for i, v in enumerate(vals[: min(8, len(vals))]):
        ax.text(v, i, f" {v:.2f}", va="center", ha="left" if v >= 0 else "right", fontsize=10)

    strongest_i = int(np.argmax(np.abs(vals))) if len(vals) else 0
    strongest = float(vals[strongest_i]) if len(vals) else 0.0
    strongest_pair = pairs[strongest_i] if len(pairs) else ""
    _badge(ax, f"Strongest pair r: {strongest:.2f}\nPair: {_shorten(strongest_pair, 70)}\nNote: correlation ≠ causation")

    _save(fig, plots_dir / "correlations_insight.png")


def build_missingness_insight(run_dir: Path, math_results: dict):
    plots_dir = _plots_dir(run_dir)
    ms = math_results.get("missingness") if isinstance(math_results, dict) else None
    if not isinstance(ms, dict):
        return

    cols = ms.get("columns")
    pct = ms.get("percent")
    if not isinstance(cols, list) or not isinstance(pct, list) or not cols or not pct:
        return

    pct = np.array(pct, dtype=float)
    cols = [str(c) for c in cols]

    order = np.argsort(-pct)[: min(12, len(pct))]
    pct = pct[order]
    cols = [cols[i] for i in order]
    cols_short = [_shorten(c, 42) for c in cols]

    _set_dark_theme()
    fig_h = max(4.8, 0.40 * len(pct) + 2.6)
    fig, ax = plt.subplots(figsize=(10.8, fig_h))

    y = np.arange(len(pct))
    ax.barh(y, pct)

    _style_ax(ax, "Top missingness • data quality risk", "Highest-missing fields first (impute, drop, or re-source)")
    ax.set_xlabel("% missing")
    ax.set_yticks(y)
    ax.set_yticklabels(cols_short, fontsize=11)
    ax.set_xlim(0, max(5.0, float(np.max(pct)) * 1.18))

    for i, v in enumerate(pct[: min(10, len(pct))]):
        ax.text(v, i, f" {v:.1f}%", va="center", ha="left", fontsize=10)

    worst_pct = float(pct[0]) if len(pct) else np.nan
    worst_col = cols[0] if len(cols) else "n/a"
    _badge(ax, f"Worst column missing: {worst_col}\nMissing: {worst_pct:.1f}%\nRecommendation: impute, drop, or re-source")

    _save(fig, plots_dir / "missingness_insight.png")


# -----------------------------
# Main entry
# -----------------------------
def main(run_dir: str):
    run_dir = _resolve_run_dir(run_dir)

    run_meta_path = run_dir / "_RUN_META.json"
    deep_math_path = run_dir / "deep_math.json"
    math_results_path = run_dir / "math_results.json"

    if not run_meta_path.exists():
        raise FileNotFoundError(f"Missing: {run_meta_path}")
    if not deep_math_path.exists():
        raise FileNotFoundError(f"Missing: {deep_math_path}")
    if not math_results_path.exists():
        raise FileNotFoundError(f"Missing: {math_results_path}")

    run_meta = _read_json(run_meta_path)
    deep_math = _read_json(deep_math_path)
    math_results = _read_json(math_results_path)

    csv_path = _get_dataset_path(run_meta)
    if not csv_path or not Path(csv_path).exists():
        raise FileNotFoundError(f"Dataset CSV not found from _RUN_META.json: {csv_path}")

    time_col = deep_math.get("time_col")
    df = _load_dataset(csv_path, time_col=time_col)

    build_forecast_insight(run_dir, df, deep_math)
    build_anomalies_insight(run_dir, math_results)
    build_correlations_insight(run_dir, math_results)
    build_missingness_insight(run_dir, math_results)

    print(f"✅ Insight plots written to: {run_dir / 'plots'}")


if __name__ == "__main__":
    import sys
    if len(sys.argv) < 2:
        print("Usage: python scripts/make_insight_plots.py <RUN_DIR>")
        sys.exit(2)
    main(sys.argv[1])
