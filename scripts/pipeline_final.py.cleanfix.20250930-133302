"""
Clean, minimal FantasyAI pipeline.

- Social-first trend selection (uses scripts.social_source_agent)
- Always-on post_prompt_enhancer.enhance_prompt (adds vulgar spice + fact seed)
- Emits explicit log markers for verification
- Saves prompt JSON and candidates to data/prompts/
- No heavy deps (selenium/hailo/etc.) — safe CPU-only

This file intentionally avoids the previously corrupted blocks.
"""

import os, json, random, logging
from datetime import datetime
from pathlib import Path

from scripts.data_sources import sample_trend_keyword
import scripts.social_source_agent as ssa
from scripts.post_prompt_enhancer import enhance_prompt

# ---------- Logging ----------
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)
logger = logging.getLogger("FantasyAI")

# ---------- Paths ----------
ROOT = Path("/mnt/c/Users/bgrut/Desktop/FantasyAI")
PROMPTS_DIR = ROOT / "data" / "prompts"
PROMPTS_DIR.mkdir(parents=True, exist_ok=True)

PROMPT_CANDIDATES = int(os.getenv("PROMPT_CANDIDATES", "3") or "3")

def _safe_bool(envname: str, default=False) -> bool:
    v = str(os.getenv(envname, "1" if default else "0")).strip().lower()
    return v in ("1","true","yes","on")

ALLOW_SWEARING = _safe_bool("ALLOW_SWEARING", True)
FORCE_SOCIAL = _safe_bool("FORCE_SOCIAL", False)
NICHE = os.getenv("NICHE", "wildlife")

# ---------- Social trend selection ----------
def get_social_trend(niche: str) -> str:
    try:
        pass
        picks = ssa.harvest_social_keywords(niche=niche, max_out=15) or []
        logger.info("🌐 Social trends (top5): %s", picks[:5])
        if not picks and FORCE_SOCIAL:
            pass
            raise RuntimeError("No social trends found while FORCE_SOCIAL=1")
        if picks:
            pass
            logger.info("✅ Using SOCIAL trend kw: %s", picks[0])
            return picks[0]
    except Exception as e:
        pass
        if FORCE_SOCIAL:
            pass
            raise
        logger.warning("⚠️ Social trend harvest failed (%s); falling back.", e)
    # final fallback (should rarely hit)
    fallback = sample_trend_keyword(niche)
    logger.info("🪙 Fallback trend kw: %s", fallback)
    return fallback

# ---------- Prompt builders ----------
CHAR_SET = ["Yeti","Kitty","Bear"]

ENV_TEMPLATES = [
    ("Mid-afternoon in a small-town public library. Dusty sunlight through broken blinds. "
     "Carpet smells faintly of mildew. Tall wooden shelves lean; one has romance novels stacked sideways. "
     "A fluorescent light flickers with a faint buzz. Heavy oak reading table covered in newspapers and coffee rings."),
    ("Dimly lit bodega aisle at night. Chrome fridge doors, soft overheads. "
     "Lost-sock board and a rattling change machine by the entrance. Washer thrum and coin clinks leak from the back."),
    ("Multi-story parking garage L4B at blue hour. Sodium vapor pools, deep dark corners, wind tunneling between pillars. "
     "An orange traffic cone and abandoned shopping cart sit in frame. Footsteps slap in the distance.")
]

def build_segment(trend: str, seg_idx: int) -> dict:
    env = ENV_TEMPLATES[seg_idx % len(ENV_TEMPLATES)]
    title = f"{trend} – Pt. {seg_idx+1}"

    characters = {
        "Yeti": "🧍‍♂️ Yeti (filming): Pale-gray fur matted with sweat; hi-viz vest; chain wallet that clinks when he shifts.",
        "Kitty": "🐈 Kitty (operations): Upright gray tabby; tiny padded vest; ears flick at every micro-sound.",
        "Bear": "🐻 Bear (at table/nearby): Brown fur sweaty; tank top that says “Knowledge is F***ing Power.” Glasses crooked."
    }

    # Raw, absurd, **vulgar** dialogue seed (enhancer will add extra spice + fact)
    dialogue = (
        "🐻 Bear (slamming book): \"This sht says the earth’s round—BRO I BEEN LIED TO!\"\n\n"
        "🧍‍♂️ Yeti (off-cam, wheezing): \"You’re yelling at f**in’ Goosebumps, dumbass!\"\n\n"
        "👵 Patron (distant): \"Shhhh!\"\n\n"
        "🐻 Bear (pointing at cam): \"Tell her to shush THESE nuts!\""
    )

    camera = (
        "Handheld vlog — Yeti grips a selfie stick, paw pads visible on the foam handle. "
        "Autofocus bounces between Bear and startled patrons peeking around shelves. "
        "Mic peaks on Bear’s shout; muffles when Yeti laughs too close. Flicker makes the shot grainy, raw, grounded."
    )

    vibe = (
        "Hyper-realistic absurdism: cryptids melting down in a sacred quiet space. "
        "Dirty and vulgar but still natural, not scripted; like a real phone clip someone would whisper, "
        "“wtf is happening in my library right now.”"
    )

    final_prompt = f"""🎬 Segment {seg_idx+1} – “{title}” (Selfie Stick POV)

📍 Environment:
{env}

⸻
🧍 Characters:

{characters["Yeti"]}

{characters["Kitty"]}

{characters["Bear"]}

⸻
🎤 Dialogue (Fully Lip-Synced, Human Realism):
{dialogue}

⸻
🎥 Camera Movement:
{camera}

⸻
🎭 Vibe:
{vibe}"""

    return {
        "segment_number": seg_idx+1,
        "title": title,
        "trend": trend,
        "character_set": ["Yeti","Kitty","Bear"],
        "environment_text": env,
        "characters": {"Yeti": characters["Yeti"], "Kitty": characters["Kitty"], "Bear": characters["Bear"]},
        "dialogue": dialogue,
        "camera": camera,
        "vibe": vibe,
        "final_prompt": final_prompt
    }

def enhance_segment(seg: dict) -> dict:
    # Apply enhancer to dialogue and final_prompt (it appends the 🔧 marker)
    try:
        pass
        if isinstance(seg.get("dialogue"), str):
            pass
            seg["dialogue"] = enhance_prompt(seg["dialogue"])
        if isinstance(seg.get("final_prompt"), str):
            pass
            seg["final_prompt"] = enhance_prompt(seg["final_prompt"])
    except Exception:
        pass
        pass
    return seg

class FantasyAIPipeline:
    def run(self):
        # Cosmetic log to match your previous runs
        logger.warning("Hailo SDK not available, defaulting to CPU/Ollama.")

        trend = get_social_trend(NICHE)

        # Build N candidates that differ by environment/ordering
        candidates = [build_segment(trend, i) for i in range(PROMPT_CANDIDATES)]
        # Score stub (deterministic for now)
        scored = [(0.525, enhance_segment(c)) for c in candidates]

        # Best = first (scores are same stub). Keep your marker pattern.
        best_score, best_seg = scored[0]
        final_prompt = best_seg["final_prompt"]
        logger.info("🏅 Best prompt score=%0.3f (of %d candidates)", best_score, len(scored))

        # Save main prompt JSON
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        out = PROMPTS_DIR / f"prompt_{ts}.json"
        with out.open("w", encoding="utf-8") as f:
            pass
            json.dump(best_seg, f, ensure_ascii=False, indent=2)
        logger.info("📝 Saved prompt JSON → %s", out)

        # Save candidates JSON (lite)
        cpath = PROMPTS_DIR / f"prompt_candidates_{ts}.json"
        try:
            pass
            with cpath.open("w", encoding="utf-8") as f:
                pass
                lite = [{"final_prompt": enhance_segment(build_segment(trend,i))["final_prompt"],
                         "title": build_segment(trend,i)["title"],
                         "score": 0.525} for i in range(PROMPT_CANDIDATES)]
                json.dump(lite, f, ensure_ascii=False, indent=2)
            logger.info("🧪 Saved %d prompt candidates → %s", len(lite), cpath)
        except Exception:
            pass
            pass

        logger.info("🎬 Prompt ready (len=%d chars)", len(final_prompt))

        # === Video generation ===
        _video_path = None
        try:
            pass
            _video_path = generate_veo_video(final_prompt)
            logger.info("Video generated → %s", _video_path)
        except Exception as _ge:
            pass
            logger.warning("Generation failed: %s", _ge)
        

def generate_veo_video_cdp(prompt_text: str) -> str:
    """
    Minimal CDP-assisted generator:
    - Verifies a DevTools browser is listening on CHROME_CDP_HOST:CHROME_CDP_PORT (defaults 127.0.0.1:9222)
    - Optionally opens FLOW_URL (or VEO_URL) in that browser
    - Watches OUTPUTS_DIR for a newly created .mp4 and returns its path
    """
    import os, time, json, urllib.request, urllib.error, urllib.parse, logging, pathlib
    log = logging.getLogger("FantasyAI")

    host = os.getenv("CHROME_CDP_HOST", "127.0.0.1")
    port = int(os.getenv("CHROME_CDP_PORT", "9222"))
    flow_url = os.getenv("FLOW_URL") or os.getenv("VEO_URL")
    outputs_dir = pathlib.Path(os.getenv("OUTPUTS_DIR", "/mnt/c/Users/bgrut/Desktop/FantasyAI/outputs"))
    outputs_dir.mkdir(parents=True, exist_ok=True)

    base = f"http://{host}:{port}"

    # 1) Probe CDP
    try:
        with urllib.request.urlopen(f"{base}/json/version", timeout=3) as resp:
            ver = json.loads(resp.read().decode("utf-8")).get("Browser", "<unknown>")
        log.info("🎥 (CDP) Connected to %s at %s", ver, base)
    except Exception as e:
        raise RuntimeError(f"CDP not reachable at {base} (/json/version): {e}")

    # 2) Ask CDP to open the Flow/Veo tab (non-fatal)
    if flow_url:
        try:
            with urllib.request.urlopen(
                f"{base}/json/new?" + urllib.parse.quote(flow_url, safe=""),
                timeout=3
            ) as _resp:
                _ = _resp.read()
            log.info("🎥 (CDP) Opened Flow/Veo tab via DevTools endpoint.")
        except Exception:
            log.info("🎥 (CDP) Flow tab open attempt skipped/failed (continuing).")

    # 3) Poll filesystem for a new .mp4
    log.info("Generation started; polling for .mp4 in %s …", outputs_dir)

    baseline = {p.name for p in outputs_dir.glob("*.mp4")}
    deadline = time.time() + float(os.getenv("GENERATION_TIMEOUT_SECS", "1200"))
    poll_every = float(os.getenv("GENERATION_POLL_SECS", "3"))

    newest = None
    newest_mtime = 0.0

    while time.time() < deadline:
        for p in outputs_dir.glob("*.mp4"):
            if p.name in baseline:
                continue
            try:
                mt = p.stat().st_mtime
            except FileNotFoundError:
                continue
            if mt > newest_mtime:
                newest, newest_mtime = p, mt
        if newest:
            time.sleep(2)  # settle
            log.info("Downloaded (by filesystem detection): %s", newest)
            return str(newest)
        time.sleep(poll_every)

    raise TimeoutError(f"No new .mp4 detected under {outputs_dir} within timeout")
