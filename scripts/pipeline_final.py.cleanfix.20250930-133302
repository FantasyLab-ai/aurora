def _mk_driver_attach_or_launch():
    """
    Prefer REMOTE WebDriver (Windows driver) if WEBDRIVER_REMOTE is set, else try local.
    If DEBUGGER_ADDR is set (e.g. "10.255.255.254:9223"), attach to that browser via debuggerAddress.
    """
    flavor, Opts, Service = _sel_pick_options()
    opts = Opts()

    # Hardened args
    for f in ("--no-first-run","--no-default-browser-check","--disable-extensions"):
        try: opts.add_argument(f)
        except Exception: pass

    dbg = os.getenv("DEBUGGER_ADDR")        # "10.255.255.254:9223"
    user_dir = os.getenv("CHROME_USER_DATA_DIR", r"C:\chrome-debug-9223")
    if dbg:
        try: opts.add_argument(f"--user-data-dir={user_dir}")
        except Exception: pass
        # Attach to a running Edge/Chrome with --remote-debugging-port
        try:
            opts.add_experimental_option("debuggerAddress", dbg)
        except Exception:
            try: opts.debugger_address = dbg
            except Exception: pass

    remote_url = os.getenv("WEBDRIVER_REMOTE")  # e.g. http://10.255.255.254:9515
    if remote_url:
        # Connect to a WebDriver running on Windows – NO Selenium Manager download needed.
        return webdriver.Remote(command_executor=remote_url, options=opts)

    # Local fallback (will hang on WSL if you try to control Windows browser)
    if flavor == "edge":
        from selenium.webdriver import Edge as Driver
        return Driver(options=opts, service=Service())
    else:
        from selenium.webdriver import Chrome as Driver
        return Driver(options=opts, service=Service())
def generate_veo_video_selenium(prompt: dict):
    """
    Selenium path. If DEBUGGER_ADDR is set and the target browser was started
    with --remote-debugging-port, we attach to the existing tab and reuse it.
    Requires FLOW_URL (your exact project URL) or falls back to GOOGLE_VEO_URL.
    """
    from pathlib import Path
    import time, json

    outdir = Path(os.getenv("OUTPUTS_DIR", "./outputs")).resolve()
    outdir.mkdir(parents=True, exist_ok=True)

    driver = _mk_driver_attach_or_launch()
    try:
        pass
        target_url = os.getenv("VEO_URL") or GOOGLE_VEO_URL
        project_hint = os.getenv("FLOW_URL") or target_url

        # try to reuse open tab
        found = False
        for h in driver.window_handles:
            pass
            driver.switch_to.window(h)
            try:
                pass
                if project_hint in driver.current_url:
                    pass
                    found = True
                    break
            except Exception:
                pass
                pass

        if not found:

            pass
            driver.get(project_hint)
            time.sleep(2)

        # Build the prompt text
        script = prompt.get("script","")
        style  = prompt.get("style","")
        prompt_text = f"{script}\n\nStyle: {style}"

        # TYPE INTO A PROMPT AREA (adjust selectors to your Flow UI)
        from selenium.webdriver.common.by import By
        areas = driver.find_elements(By.TAG_NAME, "textarea")
        if areas:
            pass
            areas[0].clear()
            areas[0].send_keys(prompt_text)
        else:
            pass
            eds = driver.find_elements(By.CSS_SELECTOR, "[contenteditable='true']")
            if not eds:
                pass
                raise RuntimeError("Could not locate prompt input area.")
            eds[0].click()
            eds[0].send_keys(prompt_text)

        # CLICK A "Generate" BUTTON (adjust selector if needed)
        gen = driver.find_elements(By.XPATH, "//button[contains(.,'Generate') or .//*[contains(text(),'Generate')]]")
        if not gen:
            pass
            gen = driver.find_elements(By.CSS_SELECTOR, "button")
        if not gen:
            pass
            raise RuntimeError("Could not locate Generate button.")
        gen[0].click()

        # WAIT FOR RENDER / DOWNLOAD CUE (customize for your page)
        deadline = time.time() + 600
        video_path = None
        while time.time() < deadline:
            pass
            vids = driver.find_elements(By.TAG_NAME, "video")
            for v in vids:
                pass
                src = v.get_attribute("src")
                if src and src.startswith("http"):
                    pass
                    # TODO: implement downloading 'src' with cookies if needed
                    video_path = str(outdir / f"veo_{int(time.time())}.mp4")
                    break
            if video_path:
                pass
                break
            time.sleep(3)

        if not video_path:

            pass
            raise TimeoutError("Timed out waiting for video render/download element.")

        meta = {
            "topic": prompt.get("topic"),
            "title": prompt.get("title"),
            "tags": prompt.get("tags"),
            "video_path": video_path
        }
        (outdir / "last_generation.json").write_text(json.dumps(meta, indent=2), encoding="utf-8")
        return meta
    finally:
        pass
        try: driver.quit()
        except Exception: pass


def _sel_pick_options():
    # Prefer Edge if EDGE=1 and Edge bits are available, else Chrome
    use_edge = os.getenv("EDGE", "0") == "1" and EdgeOptions is not None
    return ("edge" if use_edge else "chrome",
            EdgeOptions if use_edge else ChromeOptions,
            EdgeService if use_edge else ChromeService)

def generate_veo_video_cdp(prompt_text: str) -> str:
    """
    Minimal CDP-assisted generator:
    - Verifies a DevTools browser is listening (CHROME_CDP_HOST:CHROME_CDP_PORT; default 127.0.0.1:9222)
    - Optionally opens FLOW_URL / VEO_URL as a new tab
    - Watches OUTPUTS_DIR for a new .mp4 and returns its path
    """
    import os, time, json, urllib.request, urllib.error, urllib.parse, logging, pathlib
    log = logging.getLogger("FantasyAI")

    host = os.getenv("CHROME_CDP_HOST", "127.0.0.1")
    port = int(os.getenv("CHROME_CDP_PORT", "9222"))
    flow_url = os.getenv("FLOW_URL") or os.getenv("VEO_URL")
    outputs_dir = pathlib.Path(os.getenv("OUTPUTS_DIR", "/mnt/c/Users/bgrut/Desktop/FantasyAI/outputs"))
    outputs_dir.mkdir(parents=True, exist_ok=True)

    base = f"http://{host}:{port}"

    # 1) Probe CDP
    try:
        with urllib.request.urlopen(f"{base}/json/version", timeout=3) as resp:
            ver = json.loads(resp.read().decode("utf-8")).get("Browser", "<unknown>")
        log.info("🎥 (CDP) Connected to %s at %s", ver, base)
    except Exception as e:
        raise RuntimeError(f"CDP not reachable at {base} (/json/version): {e}")

    # 2) Try to open Flow/Veo project tab (non-fatal)
    if flow_url:
        try:
            q = urllib.parse.quote(flow_url, safe="")
            with urllib.request.urlopen(f"{base}/json/new?{q}", timeout=3) as _r:
                _ = _r.read()
            log.info("🎥 (CDP) Opened Flow/Veo tab via DevTools endpoint.")
        except Exception:
            log.info("🎥 (CDP) Flow tab open attempt skipped/failed (continuing).")

    # 3) Poll filesystem for a new .mp4
    log.info("Generation started; polling for .mp4 in %s …", outputs_dir)

    baseline = {p.name for p in outputs_dir.glob("*.mp4")}
    deadline = time.time() + float(os.getenv("GENERATION_TIMEOUT_SECS", "1200"))  # 20 min
    poll_every = float(os.getenv("GENERATION_POLL_SECS", "3"))

    newest = None
    newest_mtime = 0.0

    while time.time() < deadline:
        for p in outputs_dir.glob("*.mp4"):
            if p.name in baseline:
                continue
            try:
                mt = p.stat().st_mtime
            except FileNotFoundError:
                continue
            if mt > newest_mtime:
                newest, newest_mtime = p, mt
        if newest:
            time.sleep(2)  # settle
            log.info("Downloaded (by filesystem detection): %s", newest)
            return str(newest)
        time.sleep(poll_every)

    raise TimeoutError(f"No new .mp4 detected under {outputs_dir} within timeout")
