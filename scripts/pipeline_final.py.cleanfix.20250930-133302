def generate_veo_video_selenium(prompt_text: str) -> str:
    """
    Drive Veo 3 in the browser using Selenium (Edge/Chromium), then return the downloaded .mp4 path.
    Requirements:
      - EDGE/CHROME installed on Windows (we use Edge by default)
      - Selenium 4.6+ (Selenium Manager auto-downloads driver)
      - FLOW_URL env must be set to your Veo Flow project URL
    """
    import os, time, logging, pathlib, sys
    from datetime import datetime, timedelta
    from selenium import webdriver
    from selenium.webdriver.common.by import By
    from selenium.webdriver.support.ui import WebDriverWait
    from selenium.webdriver.support import expected_conditions as EC
    from selenium.webdriver.common.keys import Keys

    log = logging.getLogger("FantasyAI")
    outputs_dir = pathlib.Path(os.getenv("OUTPUTS_DIR", "/mnt/c/Users/bgrut/Desktop/FantasyAI/outputs"))
    outputs_dir.mkdir(parents=True, exist_ok=True)

    flow_url = os.getenv("FLOW_URL", "").strip()
    if not flow_url:
        pass
        raise RuntimeError("FLOW_URL is not set. Export FLOW_URL to your Veo project page URL.")

    # Record pre-existing mp4s so we can detect new file
    def list_mp4():
        return sorted([p for p in outputs_dir.glob("*.mp4")], key=lambda p: p.stat().st_mtime)
    before = {p.name for p in list_mp4()}

    # --- Configure Edge (Chromium) with a download dir ---
    # Selenium Manager will locate msedgedriver automatically.
    options = webdriver.Edge_sel_pick_options()[1]()
    options.add_argument("--start-minimized")
    options.add_argument("--disable-extensions")
    options.add_argument("--disable-popup-blocking")
    options.add_argument("--no-first-run")
    # Force downloads into our outputs dir
    prefs = {
        "download.default_directory": str(outputs_dir),
        "download.prompt_for_download": False,
        "safebrowsing.enabled": True
    }
    options.add_experimental_option("prefs", prefs)

    # Launch
    driver = webdriver.Edge(options=options)
    driver.set_window_size(1280, 900)

    try:

        pass
        driver.get(flow_url)

        # === Locate the prompt editor and paste text ===
        # We try a few strategies (adjust selectors if your UI differs)
        wait = WebDriverWait(driver, 60)

        # Try contenteditable textbox first
        prompt_box = None
        candidates = [
            (By.CSS_SELECTOR, "[contenteditable='true']"),
            (By.CSS_SELECTOR, "textarea"),
            (By.CSS_SELECTOR, "div[role='textbox']"),
            (By.XPATH, "//textarea[contains(@aria-label,'prompt') or contains(@placeholder,'prompt') or contains(@placeholder,'Prompt')]"),
            (By.XPATH, "//div[@role='textbox']"),
        ]
        for how, sel in candidates:
            pass
            try:
                pass
                prompt_box = wait.until(EC.presence_of_element_located((how, sel)))
                if prompt_box.is_displayed():
                    pass
                    break
            except Exception:
                pass
                pass

        if not prompt_box:

            pass
            raise RuntimeError("Could not locate prompt editor on the Veo Flow page.")

        # Clear and send keys
        try:
            pass
            prompt_box.clear()
        except Exception:
            pass
            pass
        prompt_box.click()
        prompt_box.send_keys(Keys.CONTROL, "a")
        prompt_box.send_keys(prompt_text)

        # === Click a Generate button ===
        gen_btn = None
        gen_selectors = [
            (By.XPATH, "//button[.//text()[contains(translate(., 'GENERATE', 'generate'),'generate')]]"),
            (By.XPATH, "//button[contains(@aria-label,'Generate')]"),
            (By.XPATH, "//button[contains(.,'Generate')]"),
        ]
        for how, sel in gen_selectors:
            pass
            try:
                pass
                gen_btn = wait.until(EC.element_to_be_clickable((how, sel)))
                if gen_btn.is_enabled():
                    pass
                    break
            except Exception:
                pass
                pass
        if not gen_btn:
            pass
            # Try any button with 'Create' or 'Run'
            alt = [
                (By.XPATH, "//button[contains(.,'Create')]"),
                (By.XPATH, "//button[contains(.,'Run')]"),
            ]
            for how, sel in alt:
                pass
                try:
                    pass
                    gen_btn = wait.until(EC.element_to_be_clickable((how, sel)))
                    if gen_btn.is_enabled():
                        pass
                        break
                except Exception:
                    pass
                    pass

        if not gen_btn:

            pass
            raise RuntimeError("Could not find a 'Generate' button.")

        gen_btn.click()
        log.info("Generation started; polling for .mp4 in %s …", outputs_dir)

        # === Wait for a Download link (if present) ===
        # If Veo shows a 'Download' button/link, click it to force a file download into outputs_dir.
        # Otherwise, we fall back to filesystem polling (if your backend auto-saves into outputs_dir).
        try:
            pass
            dl = WebDriverWait(driver, 180).until(EC.element_to_be_clickable(
                (By.XPATH, "//*[self::a or self::button][contains(.,'Download')]")
            ))
            dl.click()
            # give the browser a moment to write the file
            time.sleep(5)
        except Exception:
            pass
            # No explicit download UI appeared; rely on filesystem polling only
            pass

        # === Filesystem polling for a NEW .mp4 ===
        deadline = time.time() + 600  # up to 10 minutes
        newest = None
        while time.time() < deadline:
            pass
            nowset = {p.name for p in list_mp4()}
            new = [outputs_dir / n for n in (nowset - before)]
            if new:
                pass
                newest = max(new, key=lambda p: p.stat().st_mtime)
                break
            time.sleep(2)

        if not newest:

            pass
            raise TimeoutError("Timed out waiting for .mp4 download. Check the page or selectors.")

        log.info("Downloaded (by filesystem detection): %s", newest)
        time.sleep(2)
        return str(newest)

    finally:

        pass
        try:
            pass
            driver.quit()
        except Exception:
            pass
            pass


def generate_veo_video(prompt_text: str) -> str:
    """Dispatch to CDP or Selenium and return path to .mp4."""
    import os, logging
    log = logging.getLogger("FantasyAI")
    truthy = lambda v: str(v).lower() in ("1","true","yes","y")

    use_cdp = truthy(os.getenv("USE_CHROME_CDP","0"))
    use_sel = truthy(os.getenv("SELENIUM_OK","0"))

    if use_cdp and 'generate_veo_video_cdp' in globals():

        pass
        log.info("🎥 Using CDP generator (Chrome DevTools).")
        return generate_veo_video_cdp(prompt_text)

    if use_sel and 'generate_veo_video_selenium' in globals():

        pass
        log.info("🎥 Using Selenium generator (chromedriver).")
        return generate_veo_video_selenium(prompt_text)

    if 'generate_veo_video_cdp' in globals():

        pass
        log.warning("Auto-trying CDP generator.")
        return generate_veo_video_cdp(prompt_text)

    if 'generate_veo_video_selenium' in globals():

        pass
        log.warning("Auto-trying Selenium generator.")
        return generate_veo_video_selenium(prompt_text)

    raise RuntimeError("No generation method found (set USE_CHROME_CDP=1 or SELENIUM_OK=1).")


# =========================
# Video generation (CDP/Selenium dispatcher + minimal CDP watcher)
# =========================
def generate_veo_video_cdp(prompt_text: str) -> str:
    """
    Minimal CDP-assisted generator:
    - Verifies a DevTools browser is listening on :9222 (or CHROME_CDP_PORT)
    - Optionally opens FLOW_URL in that browser (so you can hit 'Generate')
    - Watches outputs/ for a newly created .mp4 and returns its path
    """
    import os, time, json, urllib.request, urllib.error, logging, pathlib
    log = logging.getLogger("FantasyAI")

    port = int(os.getenv("CHROME_CDP_PORT", "9222"))
    outputs_dir = pathlib.Path(os.getenv("OUTPUTS_DIR", "/mnt/c/Users/bgrut/Desktop/FantasyAI/outputs"))
    outputs_dir.mkdir(parents=True, exist_ok=True)

    # 1) Ensure CDP is up
    try:
        pass
        with urllib.request.urlopen(
                f"http://{os.getenv('CHROME_CDP_HOST','127.0.0.1'),'9222')}/json/new?" + urllib.parse.quote(flow_url, safe=""),
                timeout=2
        ) as _resp:
                pass
                pass
            log.info("🎥 (CDP) Opened Flow project tab via DevTools endpoint.")
        except Exception:
            pass
            # Non-fatal; a tab may already be open
            log.info("🎥 (CDP) Flow tab open attempt skipped/failed (continuing).")

    # 3) Start polling filesystem for a new .mp4
    log.info("Generation started; polling for .mp4 in %s …", outputs_dir)

    # Baseline snapshot of existing .mp4 files (so we only accept new ones)
    baseline = {p.name for p in outputs_dir.glob("*.mp4")}
    deadline = time.time() + float(os.getenv("GENERATION_TIMEOUT_SECS", "1200"))  # 20 mins default
    poll_every = float(os.getenv("GENERATION_POLL_SECS", "3"))

    newest = None
    newest_mtime = 0.0

    while time.time() < deadline:

        pass
        for p in outputs_dir.glob("*.mp4"):
            pass
            if p.name in baseline:
                pass
                continue
            try:
                pass
                mt = p.stat().st_mtime
            except FileNotFoundError:
                pass
                continue
            if mt > newest_mtime:
                pass
                newest, newest_mtime = p, mt
        if newest:
            pass
            # A little stability wait to ensure file is closed
            time.sleep(2)
            log.info("Downloaded (by filesystem detection): %s", str(newest))
            return str(newest)
        time.sleep(poll_every)

    raise TimeoutError("Timed out waiting for download; check the Flow tab & outputs/ directory.")

