import os
import argparse
from pprint import pprint

import numpy as np
import pandas as pd
from scipy.optimize import curve_fit

from fantasyai.config import DATA_DIR

DATA_ROOT = DATA_DIR  # typically fantasyai/data


# ---------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------
def _safe_head(df: pd.DataFrame, n: int = 5):
    return df.head(n).to_dict(orient="list")


def _print_section(title: str):
    print("=" * 80)
    print(title)
    print("=" * 80)


# ---------------------------------------------------------------------
# 1) TCGA-like expression (demo only)
# ---------------------------------------------------------------------
def run_tcga_expression_demo():
    path = os.path.join(DATA_ROOT, "tcga_expression.csv")
    _print_section("[AURORA x TCGA] Expression demo")

    if not os.path.exists(path):
        print(f"[TCGA] Skipping: {path} not found.")
        print("  -> To enable, drop a TCGA-like expression CSV at that path.")
        print()
        return

    df = pd.read_csv(path)
    info = {
        "meta": {
            "expression_path": path,
            "num_samples": len(df),
            "columns": df.columns.tolist(),
        },
        "note": "Expression table loaded; basic stats computed.",
        "summary": {
            "shape": df.shape,
            "head": _safe_head(df),
        },
    }
    pprint(info)
    print()


# ---------------------------------------------------------------------
# 2) Toy dose optimization (keep simple / unchanged)
# ---------------------------------------------------------------------
def run_tcga_toy_dose_demo():
    _print_section("[AURORA x TCGA] Toy dose optimization")

    # Toy objective: f(d) = (d-3)^2 + 0.5 * d^2
    # This has minimum near d = 2.0
    def obj(d):
        return (d - 3.0) ** 2 + 0.5 * (d ** 2)

    from scipy.optimize import minimize

    res = minimize(obj, x0=[0.0], bounds=[(0.0, 10.0)])
    sol = {
        "success": bool(res.success),
        "numeric": {"d": float(res.x[0])},
        "diagnostics": {
            "fun": float(res.fun),
            "status": int(res.status),
            "message": str(res.message),
            "nfev": int(res.nfev),
            "nit": int(res.nit),
        },
        "explanation": (
            "Aurora solved a toy dose optimization problem: minimize "
            "(d-3)^2 + 0.5*d^2 over d in [0,10]. The optimum represents a "
            "tradeoff between tumor control and toxicity."
        ),
    }
    pprint({"solution": sol})
    print()


