import argparse
import json
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, Optional, List


def _run(cmd: List[str]) -> Dict[str, Any]:
    p = subprocess.run(cmd, capture_output=True, text=True)
    return {
        "cmd": cmd,
        "ok": p.returncode == 0,
        "returncode": p.returncode,
        "stdout": p.stdout or "",
        "stderr": p.stderr or "",
    }


def _extract_last_json(stdout_text: str) -> Optional[Dict[str, Any]]:
    """
    Try to find a JSON object printed in stdout that includes run_dir.
    Falls back to last parseable JSON line.
    """
    text = stdout_text or ""
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]

    last_any: Optional[Dict[str, Any]] = None
    for ln in reversed(lines):
        if not (ln.startswith("{") and ln.endswith("}")):
            continue
        try:
            obj = json.loads(ln)
            if isinstance(obj, dict):
                last_any = obj
                if "run_dir" in obj:
                    return obj
        except Exception:
            continue
    return last_any


def _list_run_dirs(runs_root: Path) -> List[Path]:
    if not runs_root.exists():
        return []
    out: List[Path] = []
    for p in runs_root.iterdir():
        if p.is_dir():
            out.append(p)
    return out


def _pick_new_run_dir(runs_root: Path, before: List[Path], started_ts: float) -> Optional[Path]:
    """
    Robust run_dir detection even if runner stdout doesn't include JSON:
    - prefer folders created after we started
    - prefer folders not present in 'before'
    - choose most recently modified
    """
    after = _list_run_dirs(runs_root)
    before_set = {str(p.resolve()) for p in before}

    candidates: List[Path] = []
    for p in after:
        try:
            m = p.stat().st_mtime
            if m >= started_ts - 1:  # small clock skew cushion
                candidates.append(p)
        except Exception:
            continue

    # Prefer truly new dirs
    new_dirs = [p for p in candidates if str(p.resolve()) not in before_set]
    pool = new_dirs if new_dirs else candidates
    if not pool:
        return None

    pool.sort(key=lambda x: (x.stat().st_mtime if x.exists() else 0.0), reverse=True)
    return pool[0]


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--dataset", required=True)
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--also-math", action="store_true")
    ap.add_argument("--math-v2", action="store_true")
    ap.add_argument("--deep-math", action="store_true")
    ap.add_argument("--also-llm", action="store_true")
    args = ap.parse_args()

    repo_root = Path(__file__).resolve().parents[1]  # .../Aurora_QIE
    runs_root = repo_root / "outputs" / "aurora_dataset_runs"

    before_dirs = _list_run_dirs(runs_root)
    started_ts = time.time()

    cmd = [
        sys.executable,
        "-m",
        "scripts.run_aurora_dataset_runner",
        "--dataset",
        args.dataset,
        "--seed",
        str(args.seed),
    ]
    if args.also_math:
        cmd.append("--also-math")
    if args.math_v2:
        cmd.append("--math-v2")
    if args.deep_math:
        cmd.append("--deep-math")
    if args.also_llm:
        cmd.append("--also-llm")

    out = _run(cmd)

    # --- find run_dir (stdout json OR filesystem diff) ---
    runner_json = _extract_last_json(out.get("stdout", ""))
    run_dir_str = (runner_json or {}).get("run_dir") if isinstance(runner_json, dict) else None

    run_dir: Optional[Path] = None
    if run_dir_str:
        run_dir = Path(run_dir_str)
    else:
        run_dir = _pick_new_run_dir(runs_root, before_dirs, started_ts)

    artifacts: Optional[Dict[str, Any]] = None
    artifacts_error: Optional[str] = None
    plot_pack_v2: Optional[Dict[str, Any]] = None
    plot_pack_v2_error: Optional[str] = None

    if run_dir is None:
        artifacts_error = "could_not_determine_run_dir"
    else:
        try:
            # Plot Pack v2 (best effort; never fatal)
            try:
                from scripts.build_plot_pack_v2 import build_plot_pack_v2
                plot_pack_v2 = build_plot_pack_v2(run_dir)
            except Exception as e:
                plot_pack_v2_error = f"{type(e).__name__}: {e}"

            # Canonical artifact generation (PNG plots + _PLOTS_INDEX)
            from scripts.engine_artifacts import generate_all_artifacts
            artifacts = generate_all_artifacts(
                run_dir=run_dir,
                runner_stdout=runner_json,
                do_plots=True,
                do_guarded_llm=True,
            )
        except Exception as e:
            artifacts_error = f"{type(e).__name__}: {e}"

    # --- emit single JSON object for Studio UI ---
    payload: Dict[str, Any] = dict(out)
    payload["runner_json"] = runner_json
    payload["run_dir"] = str(run_dir) if run_dir else None
    payload["artifacts"] = artifacts
    if artifacts_error:
        payload["artifacts_error"] = artifacts_error
    payload["plot_pack_v2"] = plot_pack_v2
    if plot_pack_v2_error:
        payload["plot_pack_v2_error"] = plot_pack_v2_error

    print(json.dumps(payload, indent=2))
    return 0 if out.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main())
