import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, Optional


def _run(cmd: list[str]) -> dict:
    p = subprocess.run(cmd, capture_output=True, text=True)
    return {
        "cmd": cmd,
        "ok": p.returncode == 0,
        "returncode": p.returncode,
        "stdout": p.stdout or "",
        "stderr": p.stderr or "",
    }


def _extract_last_json(stdout_text: str) -> Optional[Dict[str, Any]]:
    """
    Robustly extract the runner JSON object that contains a run_dir.

    We do NOT assume the last braces in stdout are JSON, because logs may contain
    other braces. Strategy:
      - scan stdout lines from bottom to top
      - first line that parses as JSON and has "run_dir" wins
      - else fall back to the last parseable JSON object
    """
    text = stdout_text or ""
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]

    last_any: Optional[Dict[str, Any]] = None
    for ln in reversed(lines):
        if not (ln.startswith("{") and ln.endswith("}")):
            continue
        try:
            obj = json.loads(ln)
            if isinstance(obj, dict):
                last_any = obj
                if "run_dir" in obj:
                    return obj
        except Exception:
            continue

    return last_any


