
import os, re, html, urllib.parse, requests, collections, itertools

UA = os.getenv("SOCIAL_UA", os.getenv("WIKI_UA","FantasyAI/1.0 (+local)"))

STOP = set("a an and or the of in to for on with without from by at over under is are be was were has have had it this that those these you your i we they them he she his her their our".split())

def _kw_norm(s): return re.sub(r'[^a-z0-9]+',' ', s.lower()).strip()

def _ngrams(words, n):
    for i in range(len(words)-n+1):
        yield " ".join(words[i:i+n])

def _keywordize(titles, k=12):
    bag = collections.Counter()
    for t in titles:
        w = [w for w in _kw_norm(t).split() if w not in STOP and len(w) > 2]
        for n in (3,2):  # prefer 3-grams then 2-grams
            for g in _ngrams(w, n):
                if any(x.isdigit() for x in g.split()): continue
                bag[g] += 1
    ranked = [w for w,_ in bag.most_common(50)]
    # prefer concise keys (<= 22 chars)
    ranked = sorted(ranked, key=lambda s: (len(s)>22, -len(s)))  # short first, then longer
    # dedupe near-duplicates
    out, seen = [], set()
    for r in ranked:
        base = r.replace(" ", "")
        if base in seen: continue
        seen.add(base)
        out.append(r)
        if len(out) >= k: break
    return out

def _reddit_titles(niche, limit=20):
    # default wildlife subs as fallback
    subs = [niche] + (["aww","AnimalsBeingDerps","NatureIsFuckingLit","whatsthisbug","birdpics"] if niche=="wildlife" else [])
    out=[]
    for sub in subs:
        url = f"https://www.reddit.com/r/{urllib.parse.quote(sub)}/hot.json?limit=15"
        try:
            r = requests.get(url, headers={"User-Agent": UA}, timeout=3)
            if r.ok:
                for it in r.json().get("data",{}).get("children",[]):
                    t = it.get("data",{}).get("title") or ""
                    if t: out.append(t)
        except Exception: pass
        if len(out) >= limit: break
    return out[:limit]

def _youtube_titles(niche, limit=20):
    feed = f"https://www.youtube.com/feeds/videos.xml?search_query={urllib.parse.quote(niche)}"
    try:
        r = requests.get(feed, headers={"User-Agent": UA}, timeout=4)
        if not r.ok: return []
        titles = re.findall(r"<title>(.*?)</title>", r.text, flags=re.I|re.S)
        return [html.unescape(t) for t in titles[1:limit+1]]  # skip 'YouTube Search'
    except Exception:
        return []

def _ddg_snippets(niche, limit=20):
    url = f"https://duckduckgo.com/lite/?q={urllib.parse.quote(niche+' trend')}"
    try:
        r = requests.get(url, headers={"User-Agent": UA}, timeout=4)
        texts = re.findall(r'<a[^>]*>(.*?)</a>', r.text, flags=re.I|re.S)
        clean = [html.unescape(re.sub(r"<.*?>","",t)).strip() for t in texts]
        return [t for t in clean if 6 <= len(t) <= 80][:limit]
    except Exception:
        return []

def harvest_social_keywords(niche="wildlife", max_out=15):
    pools = []
    pools += _reddit_titles(niche, 20)
    pools += _youtube_titles(niche, 20)
    pools += _ddg_snippets(niche, 20)
    if not pools:
        return []
    return _keywordize(pools, k=max_out)
