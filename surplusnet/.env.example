# PostgreSQL (PostGIS-enabled image; see docker-compose.yml)
DATABASE_URL=postgresql://surplusnet:surplusnet@localhost:5433/surplusnet?schema=public

# Redis — used for high-frequency courier location caching and countdown timers.
# The phase-rollover worker falls back to an in-process scheduler when unset.
REDIS_URL=redis://localhost:6380

# Sales-phase window before an unsold item rolls over to the donation pool (minutes)
SALES_PHASE_WINDOW_MINUTES=45

# Courier dispatch radius (miles)
DISPATCH_RADIUS_MILES=1.5

# Image-recognition provider key (item category/volume extraction from photos)
VISION_API_KEY=
